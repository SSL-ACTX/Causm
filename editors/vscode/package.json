{
    "name": "causm-vscode",
    "displayName": "Causm Entropic Extension",
    "description": "Language support for Causm with Entropic Shading and Temporal Pacing.",
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": ["onLanguage:causm"],
    "main": "./out/extension.js",
    "publisher": "ssl-actx",
    "dependencies": {
        "vscode-languageclient": "^8.1.0"
    },
    "contributes": {
        "languages": [{
            "id": "causm",
            "aliases": ["Causm", "causm"],
            "extensions": [".csm"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "causm",
            "scopeName": "source.csm",
            "path": "./syntaxes/causm.tmLanguage.json"
        }],
        "configuration": {
            "title": "Causm",
            "properties": {
                "causm.lsp.path": {
                    "type": "string",
                    "default": null,
                    "description": "Path to the causm-lsp binary"
                }
            }
        },
        "semanticTokenTypes": [
            { "id": "causm_valid", "description": "Valid entropic state" },
            { "id": "causm_decayed", "description": "Decayed entropic state" },
            { "id": "causm_consumed", "description": "Consumed entropic state" }
        ],
        "semanticTokenScopes": [
            { "language": "causm", "scopes": { "causm_valid": ["variable.other"], "causm_decayed": ["markup.changed"], "causm_consumed": ["comment"] } }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/node": "^16.11.7",
        "@types/vscode": "^1.75.0",
        "typescript": "^4.5.2"
    }
}
