// src/causm.pest
WHITESPACE = _{ " " | "\t" | "\r" | "\n" | COMMENT }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* | "#" ~ (!"\n" ~ ANY)* }

program = { SOI ~ (timeline_block | statement)* ~ EOI }

timeline_block = { ("@every" ~ duration_literal | "@" ~ time_coord) ~ timeline_directive* ~ ":" ~ statement_block }
timeline_directive = { "@" ~ ("no_z3" | "chaos" | "deterministic") }
directive_stmt = { timeline_directive+ ~ ":" ~ statement_block }

time_coord     = { relative_time | absolute_time | branch_name }
absolute_time  = @{ ASCII_DIGIT+ ~ "ms" }
relative_time  = @{ "+" ~ ASCII_DIGIT+ ~ "ms" }
branch_name    = { identifier }

statement_block = { "{" ~ statement* ~ "}" | statement }

statement = {
    directive_stmt
    | isolate_stmt
    | using_stmt
    | split_stmt
    | routine_stmt
    | merge_stmt
    | split_map_stmt
    | for_stmt
    | lease_stmt
    | print_stmt
    | debug_stmt
    | anchor_stmt
    | rewind_stmt
    | commit_stmt
    | speculate_stmt
    | collapse_stmt
    | speculation_mode_stmt
    | select_stmt
    | match_entropy_stmt
    | match_stmt
    | await_stmt
    | if_let_stmt
    | if_stmt
    | break_stmt
    | loop_stmt
    | while_stmt
    | for_step_stmt
    | yield_stmt
    | type_decl
    | enum_decl
    | interface_decl
    | decay_handler_stmt
    | assert_time_stmt
    | state_stmt
    | policy_stmt
    | field_update_stmt
    | assignment_stmt
    | require_decl
    | timeline_block
    | entangle_stmt
    | slice_stmt
    | import_stmt
    | from_import_stmt
    | foreign_block_stmt
    | expression_stmt
}

foreign_block_stmt = { "foreign" ~ string_literal ~ "abi" ~ "(" ~ string_literal ~ ")" ~ "{" ~ foreign_routine* ~ "}" }
foreign_routine = { pub_opt ~ "routine" ~ identifier ~ "(" ~ param_decl_list? ~ ")" ~ return_annotation? ~ duration_limit }

import_stmt = { "import" ~ string_literal ~ ("as" ~ identifier)? }
from_import_stmt = { "from" ~ string_literal ~ "import" ~ import_symbol_list }
import_symbol_list = { wildcard_symbol | import_symbol ~ ("," ~ import_symbol)* ~ ","? }
wildcard_symbol = { "*" }
import_symbol = { identifier ~ ("as" ~ identifier)? }

expression_stmt = { expression }

entangle_stmt = { "entangle" ~ "(" ~ identifier_list ~ ")" }

decay_handler_stmt = { ("decay_handler" ~ "for" | "on_decay" ~ "(") ~ identifier ~ ")"? ~ "{" ~ statement* ~ "}" }

assert_time_stmt = { "assert_time" ~ "(" ~ "elapsed" ~ relop ~ amount ~ "ms" ~ ")" ~ ("else" ~ statement_block)? }

print_stmt = { "print" ~ "(" ~ print_arg_list ~ ")" }
print_arg_list = { expression ~ ("," ~ expression)* }

speculate_stmt = { "speculate" ~ duration_limit ~ "{" ~ statement* ~ "}" ~ fallback_stmt? }
fallback_stmt = { "fallback" ~ "{" ~ statement* ~ "}" }
collapse_stmt = { "collapse" }
speculation_mode_stmt = { "speculation_mode" ~ "(" ~ speculation_mode_value ~ ")" }
speculation_mode_value = { "selective" | "full" }
pub_keyword = @{ "pub" ~ !ASCII_ALPHANUMERIC ~ !"_" }
pub_opt = { pub_keyword? }
concise_body = { "=>" ~ expression }
routine_stmt = { pub_opt ~ "routine" ~ method_name ~ "(" ~ (method_receiver ~ ("," ~ param_decl)* | param_decl_list)? ~ ")" ~ return_annotation? ~ duration_limit ~ state_constraint? ~ (concise_body | "{" ~ statement* ~ "}") }
method_receiver = { param_mode? ~ "self" ~ type_annotation? ~ ("for" ~ amount ~ "ms")? }
method_name = { identifier ~ ("<" ~ type_param_list ~ ">")? ~ ("." ~ identifier)? }
param_decl_list = { param_decl ~ ("," ~ param_decl)* }
param_decl = { param_mode? ~ identifier ~ type_annotation? }
param_mode = { "consume" | "clone" | "decay" | "peek" | "lease" }
return_annotation = { "->" ~ type_name }

select_stmt = { "select" ~ duration_limit ~ "{" ~ select_case* ~ timeout_clause? ~ "}" ~ reconcile_clause? }
select_case = { "case" ~ identifier ~ "=" ~ expression ~ ":" ~ statement_block }
timeout_clause = { "timeout" ~ ":" ~ statement_block }

match_entropy_stmt = { "match" ~ "entropy" ~ "(" ~ expression ~ ")" ~ "{" ~ entropy_branch* ~ "}" }
guard_clause = { "if" ~ expression }
entropy_branch = { "Valid" ~ ("(" ~ identifier_or_pattern ~ ")")? ~ guard_clause? ~ ":" ~ statement_block | "Decayed" ~ ("(" ~ identifier_or_pattern ~ ")")? ~ guard_clause? ~ ":" ~ statement_block | "Pending" ~ ("(" ~ identifier_or_pattern ~ ")")? ~ guard_clause? ~ ":" ~ statement_block | "Consumed" ~ guard_clause? ~ ":" ~ statement_block }
identifier_or_pattern = { identifier | "{" ~ field_pattern_list ~ "}" }
field_pattern_list = { field_pattern ~ ("," ~ field_pattern)* ~ ","? }
field_pattern = { identifier ~ ("=" ~ (entropic_state_name | expression))? }
entropic_state_name = { "Valid" | "Decayed" | "Pending" | "Consumed" }

match_stmt = { "match" ~ expression ~ "{" ~ match_arm* ~ "}" }
match_arm = { match_pattern ~ guard_clause? ~ "=>" ~ (statement_block | statement) ~ ","? }

break_stmt = { "break" }

for_stmt = { "for" ~ identifier ~ param_mode ~ identifier ~ pacing_opt? ~ duration_limit? ~ "{" ~ statement* ~ "}" }
lease_stmt = { "lease" ~ identifier ~ "=" ~ identifier ~ duration_limit ~ statement_block ~ reconcile_clause? }
split_map_stmt = { "split_map" ~ identifier ~ param_mode ~ identifier ~ "{" ~ statement* ~ "}" ~ reconcile_clause }

pacing_opt = { "pacing" ~ duration_limit }

debug_stmt = { ("debug" | "log") ~ "(" ~ expression ~ ")" }

if_stmt = { "if" ~ "(" ~ expression ~ ")" ~ statement_block ~ ("else" ~ statement_block)? ~ reconcile_clause? }
loop_stmt = { "loop" ~ "on" ~ expression ~ statement_block | "loop" ~ duration_limit ~ "{" ~ statement* ~ "}" | "loop" ~ "tick" ~ "on" ~ identifier ~ "{" ~ statement* ~ "}" | "loop" ~ "tick" ~ "{" ~ statement* ~ "}" }
while_stmt = { "while" ~ "valid" ~ "(" ~ expression ~ ")" ~ duration_limit ~ "{" ~ statement* ~ "}" | "while" ~ "(" ~ expression ~ ")" ~ duration_limit ~ "{" ~ statement* ~ "}" }
step_spec = { duration_wildcard | duration_literal }
for_step_stmt = { "for" ~ identifier ~ "in" ~ range_expr ~ "step" ~ step_spec ~ "{" ~ statement* ~ "}" }
range_expr = { (duration_literal | expression) ~ ".." ~ (duration_literal | expression) | expression }

state_stmt = { "state" ~ identifier ~ type_annotation? ~ "=" ~ expression }
policy_target = { "on_full" | "on_deadline_breach" | "on_overflow" }
policy_kind = { "EvictDecayed" | "RingBuffer" | "Throttle" | "FailFast" }
policy_stmt = { "policy" ~ policy_target ~ "=" ~ policy_kind }

slice_stmt = { "slice" ~ amount ~ "ms" }

isolate_stmt = { "isolate" ~ identifier? ~ "{" ~ manifest ~ statement* ~ "}" }
manifest     = { (resource_decl | require_decl | slice_decl)* }
slice_decl   = { "slice" ~ amount ~ "ms" }
resource_decl = { "enable" ~ identifier ~ "(" ~ amount ~ unit? ~ ")" }
amount       = @{ ASCII_DIGIT+ }
unit         = { "ms" | "KB" | "MB" | "bytes" }

require_decl  = { "require" ~ capability_path ~ ("(" ~ param_list ~ ")")? }
capability_path = @{ identifier ~ ("." ~ identifier)* }
param_list      = { param ~ ("," ~ param)* }
param           = { (identifier | string_literal) ~ ("=" | ":") ~ expression }

split_stmt = { "split" ~ identifier ~ "into" ~ "[" ~ identifier_list ~ "]" }
merge_stmt = { "merge" ~ "[" ~ identifier_list ~ "]" ~ "into" ~ identifier ~ duration_limit? ~ reconcile_clause? ~ fallback_stmt? }
identifier_list = { identifier ~ ("," ~ identifier)* }
resolution_rules = { res_rule ~ ("," ~ res_rule)* }
res_rule = { (identifier | string_literal | "_") ~ ("=" | ":") ~ resolution_strategy }
resolution_strategy = { 
    "first_wins" | 
    "decay" | 
    "auto" | 
    "priority" ~ "(" ~ identifier ~ ")" |
    topology_union | 
    topology_intersect |
    identifier
}
topology_union = { "topology_union" ~ "{" ~ resolution_rules ~ (on_invalid_clause)? ~ "}" }
topology_intersect = { "topology_intersect" ~ "{" ~ resolution_rules ~ (on_invalid_clause)? ~ "}" }
on_invalid_clause = { "on_invalid" ~ ":" ~ rewind_clause }
rewind_clause = { "rewind" ~ identifier ~ "to" ~ identifier }
reconcile_clause = { "reconcile" ~ ("auto" | "(" ~ resolution_rules ~ ")") }
duration_wildcard = { "_" | "?" }
duration_limit = { "("? ~ ("taking" | "for" | "max" | "deadline") ~ (amount ~ time_unit | duration_wildcard) ~ ")"? | "(" ~ (amount ~ time_unit | duration_wildcard) ~ ")" | amount ~ time_unit }
anchor_stmt = { "anchor" ~ identifier }
rewind_stmt = { "rewind_to" ~ "(" ~ identifier ~ ")" }
commit_stmt = { "commit" ~ "{" ~ statement* ~ "}" }
using_stmt = { "using" ~ identifier ~ "=" ~ expression ~ statement_block }
lifetime_annotation = { "@" ~ ("valid" | "decay_rate" ~ "(" ~ (float_literal | duration_literal) ~ ")" | "decayed" ~ ("(" ~ (param | duration_literal) ~ ")")?) }
destructure_field = { identifier ~ (as_keyword ~ identifier)? }
destructure_pattern = { "{" ~ destructure_field ~ ("," ~ destructure_field)* ~ ","? ~ "}" }
mut_keyword = @{ "mut" ~ !ASCII_ALPHANUMERIC ~ !"_" }
mut_opt = { mut_keyword? }
assignment_target = { destructure_pattern | primary_expr }
assignment_stmt = { "let" ~ mut_opt ~ lifetime_annotation? ~ assignment_target ~ type_annotation? ~ ("=" ~ expression)? }

type_annotation = { ":" ~ type_name }
type_name = { union_type }
union_type = { optional_type ~ ("|" ~ optional_type)* }
optional_type = { base_type ~ "?"? }
array_bracket_type = { "[" ~ type_name ~ "]" }
base_type = { array_bracket_type | "i8" | "i16" | "i32" | "i64" | "int" | "u8" | "u16" | "u32" | "u64" | "f32" | "f64" | "float" | "bool" | "string" | "struct" | "topology" | "array" | identifier ~ ("<" ~ type_param_list ~ ">")? }
type_param_list = { type_param ~ ("," ~ type_param)* }
type_param = { amount ~ "ms" | amount | type_name }

await_stmt = { "await" ~ "(" ~ identifier ~ ")" }
await_expr = { "await" ~ "(" ~ expression ~ ")" }

defer_expr = { "defer" ~ capability_path ~ "(" ~ param_list? ~ ")" ~ duration_limit }

yield_stmt = { "yield" ~ identifier }

expression = { pipeline_expr }
pipeline_expr = { logical_or_expr ~ ("|>" ~ logical_or_expr)* }
logical_or_expr = { logical_and_expr ~ (logor ~ logical_and_expr)* }
logical_and_expr = { relational_expr ~ (logand ~ relational_expr)* }
logor = { "||" }
logand = { "&&" }
relational_expr = {
    additive_expr ~ (relop ~ additive_expr)*
}
relop = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
additive_expr = { multiplicative_expr ~ (addop ~ multiplicative_expr)* }
addop = { "+" | "-" }
multiplicative_expr = { power_expr ~ (mulop ~ power_expr)* }
mulop = { "*" | "/" | "%" }
power_expr = { unary_expr ~ (powop ~ unary_expr)* }
powop = { "^" }
unary_expr = { neg_expr | not_expr | primary_expr }
neg_expr = { "-" ~ unary_expr }
not_expr = { "!" ~ unary_expr }
primary_expr = { base_expr ~ (try_tail | index_access | method_call_tail | type_assertion_tail | type_cast_tail | field_access_tail)* }
try_tail = { "?" }
method_call_tail = { "." ~ identifier ~ "(" ~ expression_list? ~ ")" }
type_assertion_tail = { "." ~ "(" ~ type_name ~ ")" }
as_keyword = @{ "as" ~ !ASCII_ALPHANUMERIC ~ !"_" }
type_cast_tail = { as_keyword ~ type_name }
field_access_tail = { "." ~ identifier }
field_update_stmt = { primary_expr ~ "=" ~ expression }
null = @{ "null" ~ !ASCII_ALPHANUMERIC ~ !"_" }
time_unit = { "ns" | "us" | "ms" | "s" }
duration_literal = @{ ASCII_DIGIT+ ~ time_unit }
if_expr = { "if" ~ "(" ~ expression ~ ")" ~ ("{" ~ expression ~ "}" | primary_expr) ~ "else" ~ ("{" ~ expression ~ "}" | if_expr | primary_expr) }
match_entropy_expr = { "match" ~ "entropy" ~ "(" ~ expression ~ ")" ~ "{" ~ entropy_branch* ~ "}" }
match_expr = { "match" ~ expression ~ "{" ~ match_expr_arm* ~ "}" }
match_expr_arm = { match_pattern ~ guard_clause? ~ "=>" ~ expression ~ ","? }
syscall_expr = { "syscall" ~ "(" ~ (string_literal | integer_literal) ~ ("," ~ expression)* ~ ")" ~ duration_limit? }
path_expr = { identifier ~ "::" ~ identifier ~ ("(" ~ expression_list? ~ ")")? }
arena_introspect_kind = { "remaining" | "used_bytes" | "capacity" }
arena_expr = { "arena" ~ "." ~ arena_introspect_kind ~ "(" ~ ")" }
base_expr = { null | if_expr | path_expr | match_entropy_expr | match_expr | syscall_expr | await_expr | defer_expr | arena_expr | call_expr | chan_recv_expr | str_bytes_expr | to_str_expr | len_expr | clone_op | ref_op | struct_lit | topology_lit | array_lit | byte_string | hex_byte_string | float_literal | duration_literal | integer_literal | bool_literal | fstring_literal | string_literal | direct_call_expr | identifier_expr | "(" ~ expression ~ ")" }
ref_op = { "&" ~ base_expr }
index_access = { "[" ~ slice_range ~ "]" | "[" ~ expression ~ "]" }
slice_range = { expression? ~ ".." ~ "="? ~ expression? }
bool_literal = { "true" | "false" }
call_expr = { "call" ~ method_name ~ "(" ~ expression_list? ~ ")" }
direct_call_expr = { identifier ~ "(" ~ expression_list? ~ ")" }
expression_list = { expression ~ ("," ~ expression)* }

array_lit = { array_repeat | array_elements }
array_repeat = { "[" ~ expression ~ ";" ~ expression ~ "]" }
array_elements = { "[" ~ (expression ~ ("," ~ expression)* ~ ","?)? ~ "]" }

hex_integer_literal = @{ ("0x" | "0X") ~ ASCII_HEX_DIGIT+ }
integer_literal = @{ hex_integer_literal | "-"? ~ ASCII_DIGIT+ }
byte_string = @{ "b\"" ~ (!"\"" ~ ANY)* ~ "\"" }
hex_byte_string = @{ "hex\"" ~ (!"\"" ~ ANY)* ~ "\"" }
float_literal = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
struct_lit = { "struct" ~ "{" ~ param_list? ~ "}" }
topology_lit = { "topology" ~ "{" ~ param_list? ~ "}" }
clone_op   = { "clone" ~ "(" ~ identifier ~ ")" }
str_bytes_expr = { "str_bytes" ~ "(" ~ expression ~ ")" }
to_str_expr    = { "to_str" ~ "(" ~ expression ~ ")" }
len_expr       = { "len" ~ "(" ~ expression ~ ")" }
field_access = { identifier ~ "." ~ identifier }
identifier_expr = { identifier }
chan_recv_expr = { "chan_recv" ~ "(" ~ identifier ~ ")" }
type_field = { "const"? ~ identifier ~ ":" ~ type_name ~ ("=" ~ expression)? }
type_field_list = { type_field ~ ("," ~ type_field)* }
decay_opt = { "decay_after" ~ amount ~ "ms" }
auto_drop_opt = { "auto_drop" ~ "(" ~ string_literal ~ "," ~ string_literal ~ "," ~ identifier ~ ")" }
scoped_opt = { "scoped" ~ "(" ~ "@" ~ identifier ~ ")" }
generic_param = { identifier ~ (":" ~ identifier)? }
generic_param_list = { "<" ~ generic_param ~ ("," ~ generic_param)* ~ ">" }
type_decl = { pub_opt ~ "type" ~ identifier ~ generic_param_list? ~ "=" ~ (base_type ~ "+")? ~ "struct" ~ decay_opt? ~ auto_drop_opt? ~ scoped_opt? ~ "{" ~ type_field_list? ~ "}" ~ decay_opt? ~ auto_drop_opt? ~ scoped_opt? }
assoc_type_decl = { "type" ~ identifier ~ (":" ~ identifier)? }
interface_item = { assoc_type_decl | interface_method }
interface_decl = { pub_opt ~ "interface" ~ identifier ~ generic_param_list? ~ ("=" ~ interface_sum)? ~ decay_opt? ~ ("{" ~ interface_item* ~ "}")? }
interface_sum = { interface_term ~ ("+" ~ interface_term)* }
interface_term = { identifier ~ decay_opt? | "interface" ~ decay_opt? ~ "{" ~ interface_item* ~ "}" }
interface_method = { "routine" ~ identifier ~ "(" ~ param_decl_list? ~ ")" ~ return_annotation? ~ duration_limit? ~ state_constraint? ~ ("{" ~ statement* ~ "}" | ";")? }
state_constraint = { "where" ~ identifier ~ "." ~ "state" ~ "==" ~ identifier }

enum_decl = { pub_opt ~ "enum" ~ identifier ~ generic_param_list? ~ "{" ~ enum_variant_list? ~ "}" }
enum_variant_list = { enum_variant ~ ("," ~ enum_variant)* ~ ","? }
enum_variant = { identifier ~ ("(" ~ type_name_list ~ ")")? }
type_name_list = { type_name ~ ("," ~ type_name)* }

match_pattern = {
    enum_pattern
    | literal_pattern
    | wildcard_pattern
    | ident_pattern
}
enum_pattern = {
    (identifier ~ "::" ~ identifier ~ ("(" ~ pattern_arg_list? ~ ")")?)
    | (identifier ~ "(" ~ pattern_arg_list? ~ ")")
}
pattern_arg_list = { match_pattern ~ ("," ~ match_pattern)* ~ ","? }
literal_pattern = { float_literal | integer_literal | bool_literal | string_literal | null }
wildcard_pattern = { "_" }
ident_pattern = { identifier }

if_let_stmt = { "if" ~ "let" ~ match_pattern ~ "=" ~ expression ~ statement_block ~ ("else" ~ statement_block)? ~ reconcile_clause? }

identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
string_literal = @{ "\"" ~ (!("\"" | "\\") ~ ANY | "\\" ~ ANY)* ~ "\"" }
fstring_literal = ${ "f\"" ~ fstring_part* ~ "\"" }
fstring_part = { fstring_interp | fstring_text }
fstring_interp = !{ "{" ~ expression ~ "}" }
fstring_text = @{ (!("{" | "\"" | "\\") ~ ANY | "\\" ~ ANY)+ }
