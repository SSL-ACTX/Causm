@0ms: {
    from "std/core/types" import *

    routine Option.is_some(&self: Option) -> bool taking _ => match self {
        Option::Some(_) => true,
        _ => false,
    }

    routine Option.is_none(&self: Option) -> bool taking _ => match self {
        Option::None => true,
        _ => false,
    }

    routine Option.unwrap_or(&self: Option, &default_val: any) -> any taking _ => match self {
        Option::Some(v) => v,
        _ => default_val,
    }

    routine Result.is_ok(&self: Result) -> bool taking _ => match self {
        Result::Ok(_) => true,
        _ => false,
    }

    routine Result.is_err(&self: Result) -> bool taking _ => match self {
        Result::Err(_) => true,
        _ => false,
    }

    routine Result.unwrap_or(&self: Result, &default_val: any) -> any taking _ => match self {
        Result::Ok(v) => v,
        _ => default_val,
    }
}
