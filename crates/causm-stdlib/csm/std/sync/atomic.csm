@0ms: {
    from "std/sync/types" import AtomicInt, AtomicBool, FetchAddResult, CasIntResult, CasBoolResult

    routine Atomic.new_int(&initial: int) -> AtomicInt taking _ => __sync_atomic_new_int(initial)

    routine Atomic.load_int(&a: AtomicInt) -> int taking _ => __sync_atomic_load_int(a)

    routine Atomic.store_int(consume a: AtomicInt, &val: int) -> AtomicInt taking _ => __sync_atomic_store_int(a, val)

    routine Atomic.fetch_add(consume a: AtomicInt, &delta: int) -> FetchAddResult taking _ => __sync_atomic_fetch_add(a, delta)

    routine Atomic.cas_int(consume a: AtomicInt, &expected: int, &desired: int) -> CasIntResult taking _ => __sync_atomic_cas_int(a, expected, desired)

    routine Atomic.new_bool(&initial: bool) -> AtomicBool taking _ => __sync_atomic_new_bool(initial)

    routine Atomic.load_bool(&a: AtomicBool) -> bool taking _ => __sync_atomic_load_bool(a)

    routine Atomic.store_bool(consume a: AtomicBool, &val: bool) -> AtomicBool taking _ => __sync_atomic_store_bool(a, val)

    routine Atomic.cas_bool(consume a: AtomicBool, &expected: bool, &desired: bool) -> CasBoolResult taking _ => __sync_atomic_cas_bool(a, expected, desired)
}
