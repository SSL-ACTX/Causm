@0ms: {
    from "std/sync/types" import Mutex, LockResult

    routine Mutex.new() -> Mutex taking _ => __sync_mutex_new()

    routine Mutex.try_lock(consume m: Mutex, &owner: string) -> LockResult taking _ => __sync_mutex_try_lock(m, owner)

    routine Mutex.unlock(consume m: Mutex) -> Mutex taking _ => __sync_mutex_unlock(m)

    routine Mutex.is_locked(&m: Mutex) -> bool taking _ => __sync_mutex_is_locked(m)

    routine Mutex.owner(&m: Mutex) -> string taking _ => __sync_mutex_owner(m)
}
