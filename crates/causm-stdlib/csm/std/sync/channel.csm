@0ms: {
    from "std/sync/types" import SyncChannel, SendResult, RecvResult

    routine SyncChannel.new(&capacity: int) -> SyncChannel taking _ => __sync_channel_new(capacity)

    routine SyncChannel.send(consume ch: SyncChannel, &val: int) -> SendResult taking _ => __sync_channel_send(ch, val)

    routine SyncChannel.recv(consume ch: SyncChannel) -> RecvResult taking _ => __sync_channel_recv(ch)

    routine SyncChannel.close(consume ch: SyncChannel) -> SyncChannel taking _ => __sync_channel_close(ch)

    routine SyncChannel.is_closed(&ch: SyncChannel) -> bool taking _ => __sync_channel_is_closed(ch)

    routine SyncChannel.len(&ch: SyncChannel) -> int taking _ => __sync_channel_len(ch)

    routine SyncChannel.is_full(&ch: SyncChannel) -> bool taking _ => __sync_channel_is_full(ch)

    routine SyncChannel.is_empty(&ch: SyncChannel) -> bool taking _ => __sync_channel_is_empty(ch)
}
