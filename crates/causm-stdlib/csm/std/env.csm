// std/env.csm - Pure Causm Process Environment Standard Library Module

foreign "libc.so.6" abi("C") {
    pub routine getpid() -> i32 taking 1ms
    pub routine getppid() -> i32 taking 1ms
    pub routine getuid() -> i32 taking 1ms
    pub routine getcwd() -> string taking 1ms
}

pub routine current_pid() -> i32 taking _ {
    call getpid()
}

pub routine parent_pid() -> i32 taking _ {
    call getppid()
}

pub routine user_id() -> i32 taking _ {
    call getuid()
}

pub routine current_dir() -> string taking _ {
    call getcwd()
}

