@0ms: {
    foreign "libc.so.6" abi("C") {
        routine getpid() -> i32 taking 1ms
        routine getppid() -> i32 taking 1ms
        routine getuid() -> i32 taking 1ms
        routine getcwd() -> string taking 1ms
    }

    routine current_pid() -> i32 taking _ {
        if (capability(System.FFI)) {
            getpid()
        } else {
            1
        } reconcile auto
    }

    routine parent_pid() -> i32 taking _ {
        if (capability(System.FFI)) {
            getppid()
        } else {
            0
        } reconcile auto
    }

    routine user_id() -> i32 taking _ {
        if (capability(System.FFI)) {
            getuid()
        } else {
            1000
        } reconcile auto
    }

    routine current_dir() -> string taking _ {
        if (capability(System.FFI)) {
            getcwd()
        } else {
            "/"
        } reconcile auto
    }
}
