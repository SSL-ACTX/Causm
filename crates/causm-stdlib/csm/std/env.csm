@0ms: {
    foreign "libc.so.6" abi("C") {
        routine getpid() -> i32 taking 1ms
        routine getppid() -> i32 taking 1ms
        routine getuid() -> i32 taking 1ms
        routine getcwd() -> string taking 1ms
    }

    routine current_pid() -> i32 taking _ => getpid()

    routine parent_pid() -> i32 taking _ => getppid()

    routine user_id() -> i32 taking _ => getuid()

    routine current_dir() -> string taking _ => getcwd()
}
