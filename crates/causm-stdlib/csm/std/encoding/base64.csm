@0ms: {
    routine Base64.alphabet_char(&idx: i32) -> i32 taking _ => if (idx < 26) {
        65 + idx
    } else if (idx < 52) {
        71 + idx
    } else if (idx < 62) {
        idx - 4
    } else if (idx == 62) { 43 } else { 47 }

    routine Base64.decode_char(&c: i32) -> i32 taking _ => if (c == 43) {
        62
    } else if (c == 47) {
        63
    } else if (c >= 97) {
        if (c <= 122) { c - 71 } else { 0 }
    } else if (c >= 65) {
        if (c <= 90) { c - 65 } else { 0 }
    } else if (c >= 48) {
        if (c <= 57) { c + 4 } else { 0 }
    } else {
        0
    }

    routine Base64.encode_chunk(&b0: i32, &b1: i32, &b2: i32) -> array taking _ => base64_encode_chunk(b0, b1, b2)

    routine Base64.decode_chunk(&c0: i32, &c1: i32, &c2: i32, &c3: i32) -> array taking _ => base64_decode_chunk(c0, c1, c2, c3)

    routine Base64.encode(&bytes: array) -> string taking _ => base64_encode(bytes)

    routine Base64.decode(&b64: string) -> array taking _ => base64_decode(b64)
