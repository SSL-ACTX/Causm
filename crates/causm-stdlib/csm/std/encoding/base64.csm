    routine Base64.encode_chunk(peek b0: i32, peek b1: i32, peek b2: i32) -> array taking _ {
        let i0 = b0 / 4
        let i1 = (b0 % 4) * 16 + b1 / 16
        let i2 = (b1 % 16) * 4 + b2 / 64
        let i3 = b2 % 64
        let c0 = Base64.alphabet_char(i0)
        let c1 = Base64.alphabet_char(i1)
        let c2 = Base64.alphabet_char(i2)
        let c3 = Base64.alphabet_char(i3)
        [c0, c1, c2, c3]
    }
    routine Base64.decode_chunk(peek c0: i32, peek c1: i32, peek c2: i32, peek c3: i32) -> array taking _ {
        let v0 = Base64.decode_char(c0)
        let v1 = Base64.decode_char(c1)
        let v2 = Base64.decode_char(c2)
        let v3 = Base64.decode_char(c3)
        let b0 = v0 * 4 + v1 / 16
        let b1 = (v1 % 16) * 16 + v2 / 4
        let b2 = (v2 % 4) * 64 + v3
        [b0, b1, b2]
    }
    routine Base64.encode(peek bytes: array) -> string taking _ {
        let n = len(bytes)
        let mut out = [0; 64]
        let i = 0
        let j = 0
        while (i + 2 < n) taking _ {
            let b0 = bytes[i]
            let b1 = bytes[i + 1]
            let b2 = bytes[i + 2]
            let chunk = Base64.encode_chunk(b0, b1, b2)
            out[j] = chunk[0]
            out[j + 1] = chunk[1]
            out[j + 2] = chunk[2]
            out[j + 3] = chunk[3]
            let i = i + 3
            let j = j + 4
        }
