    routine Base64.alphabet_char(peek idx: i32) -> i32 taking _ => if (idx < 26) { 65 + idx } else if (idx < 52) { 71 + idx } else if (idx < 62) { idx - 4 } else if (idx == 62) { 43 } else { 47 }
