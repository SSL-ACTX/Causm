@0ms: {
    from "std/collection/types" import RingBuffer
}

@0ms: {
    routine RingBuffer.new(&capacity: i32) -> RingBuffer taking _ {
        let cap = if (capacity > 0) { clone(capacity) } else { 16 }
        let raw = [0; cap]
        struct {
            capacity = cap,
            data = raw,
            head = 0,
            size = 0,
            tail = 0
        }
    }

    routine RingBuffer.push(&rb: RingBuffer, &value: i64) -> RingBuffer taking _ {
        let mut cap = rb.capacity
        let mut cur_tail = rb.tail
        let mut cur_head = rb.head
        let mut cur_size = rb.size
        let mut data = rb.data
        data[cur_tail] = value
        let next_tail = (cur_tail + 1) % cap
        let next_head = if (cur_size == cap) {
            (cur_head + 1) % cap
        } else {
            clone(cur_head)
        }
        let next_size = if (cur_size == cap) { clone(cap) } else { cur_size + 1 }
        struct {
            capacity = cap,
            data = data,
            head = next_head,
            size = next_size,
            tail = next_tail
        }
    }

    routine RingBuffer.pop(&rb: RingBuffer) -> RingBuffer taking _ {
        let cur_size = rb.size
        let cur_head = rb.head
        let next_head = if (cur_size > 0) {
            (cur_head + 1) % rb.capacity
        } else {
            clone(cur_head)
        }
        let next_size = if (cur_size > 0) { cur_size - 1 } else { 0 }
        struct {
            capacity = rb.capacity,
            data = rb.data,
            head = next_head,
            size = next_size,
            tail = rb.tail
        }
    }

    routine RingBuffer.peek(&rb: RingBuffer) -> i64 taking _ => if (rb.size > 0) { rb.data[rb.head] } else { 0 }

    routine RingBuffer.is_full(&rb: RingBuffer) -> bool taking _ => rb.size == rb.capacity

    routine RingBuffer.is_empty(&rb: RingBuffer) -> bool taking _ => rb.size == 0

    routine RingBuffer.len(&rb: RingBuffer) -> i32 taking _ => rb.size

    routine RingBuffer.to_array(&rb: RingBuffer) -> array taking _ {
        let mut cur_size = rb.size
        let mut cap = rb.capacity
        let mut cur_head = rb.head
        let data = rb.data
        let mut out = [0; clone(cur_size)]
        let mut i = 0
        while (i < cur_size) taking _ {
            let read_idx = (cur_head + i) % cap
            out[i] = data[read_idx]
            i = i + 1
        }
        out
    }
}
