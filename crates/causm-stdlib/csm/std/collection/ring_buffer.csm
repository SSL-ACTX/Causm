// Standard Collection Module - RingBuffer (Circular Buffer) Operations

from "std/collection/types" import RingBuffer

@0ms: {
    routine RingBuffer.new(peek capacity: i32) -> RingBuffer taking _ {
        let mut cap = 16
        if (capacity > 0) {
            cap = clone(capacity)
        } reconcile auto
        let raw = [0; cap]
        struct {
            data = raw,
            head = 0,
            tail = 0,
            size = 0,
            capacity = cap
        }
    }

    routine RingBuffer.push(peek rb: RingBuffer, peek value: i64) -> RingBuffer taking _ {
        let mut cap = rb.capacity
        let mut cur_tail = rb.tail
        let mut cur_head = rb.head
        let mut cur_size = rb.size
        let mut data = rb.data

        data[cur_tail] = value
        let next_tail = (cur_tail + 1) % cap

        let mut next_head = clone(cur_head)
        if (cur_size == cap) {
            next_head = (cur_head + 1) % cap
        } reconcile auto

        let mut next_size = cur_size + 1
        if (cur_size == cap) {
            next_size = clone(cap)
        } reconcile auto

        struct {
            data = data,
            head = next_head,
            tail = next_tail,
            size = next_size,
            capacity = cap
        }
    }

    routine RingBuffer.pop(peek rb: RingBuffer) -> RingBuffer taking _ {
        let mut cur_size = rb.size
        let mut cur_head = rb.head
        let mut next_head = clone(cur_head)
        let mut next_size = 0
        if (cur_size > 0) {
            let cap = rb.capacity
            next_head = (cur_head + 1) % cap
            next_size = cur_size - 1
        } reconcile auto
        struct {
            data = rb.data,
            head = next_head,
            tail = rb.tail,
            size = next_size,
            capacity = rb.capacity
        }
    }

    routine RingBuffer.peek(peek rb: RingBuffer) -> i64 taking _ {
        let mut cur_size = rb.size
        let mut head_val = 0
        if (cur_size > 0) {
            let head_idx = rb.head
            let data = rb.data
            head_val = data[head_idx]
        } reconcile auto
        head_val
    }

    routine RingBuffer.is_full(peek rb: RingBuffer) -> bool taking _ {
        rb.size == rb.capacity
    }

    routine RingBuffer.is_empty(peek rb: RingBuffer) -> bool taking _ {
        rb.size == 0
    }

    routine RingBuffer.len(peek rb: RingBuffer) -> i32 taking _ {
        rb.size
    }

    routine RingBuffer.to_array(peek rb: RingBuffer) -> array taking _ {
        let mut cur_size = rb.size
        let mut cap = rb.capacity
        let mut cur_head = rb.head
        let data = rb.data
        let mut out = [0; clone(cur_size)]
        let mut i = 0
        while (i < cur_size) taking _ {
            let read_idx = (cur_head + i) % cap
            out[i] = data[read_idx]
            i = i + 1
        }
        out
    }
}
