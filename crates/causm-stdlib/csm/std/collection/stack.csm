// Standard Collection Module - Stack Operations

from "std/collection/types" import Stack

@0ms: {
    routine Stack.new(peek capacity: i32) -> Stack taking _ {
        let cap = if (capacity > 0) { clone(capacity) } else { 16 }
        let raw = [0; cap]
        struct {
            data = raw,
            len = 0,
            capacity = cap
        }
    }

    routine Stack.push(peek stack: Stack, peek item: i64) -> Stack taking _ {
        let mut cur_len = stack.len
        let mut cur_cap = stack.capacity
        let mut data = stack.data

        if (cur_len >= cur_cap) {
            let new_cap = cur_cap * 2
            let mut new_data = [0; new_cap]
            let mut idx = 0
            for elem in data step _ {
                new_data[idx] = elem
                idx = idx + 1
            }
            data = new_data
            cur_cap = new_cap
        }

        data[cur_len] = item
        let new_len = cur_len + 1

        struct {
            data = data,
            len = new_len,
            capacity = cur_cap
        }
    }

    routine Stack.pop(peek stack: Stack) -> Stack taking _ {
        let cur_len = stack.len
        let new_len = if (cur_len > 0) { cur_len - 1 } else { 0 }
        struct {
            data = stack.data,
            len = new_len,
            capacity = stack.capacity
        }
    }

    routine Stack.peek(peek stack: Stack) -> i64 taking _ => if (stack.len > 0) { stack.data[stack.len - 1] } else { 0 }

    routine Stack.is_empty(peek stack: Stack) -> bool taking _ => stack.len == 0

    routine Stack.len(peek stack: Stack) -> i32 taking _ => stack.len

    routine Stack.to_array(peek stack: Stack) -> array taking _ {
        let n = stack.len
        let data = stack.data
        data[0..n]
    }
}
