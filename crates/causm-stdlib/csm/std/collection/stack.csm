// Standard Collection Module - Stack Operations

from "std/collection/types" import Stack

@0ms: {
    routine Stack.new(peek capacity: i32) -> Stack taking _ {
        let mut cap = 16
        if (capacity > 0) {
            cap = clone(capacity)
        } reconcile auto
        let raw = [0; cap]
        struct {
            data = raw,
            len = 0,
            capacity = cap
        }
    }

    routine Stack.push(peek stack: Stack, peek item: i64) -> Stack taking _ {
        let mut cur_len = stack.len
        let mut cur_cap = stack.capacity
        let mut data = stack.data

        if (cur_len >= cur_cap) {
            let new_cap = cur_cap * 2
            let mut new_data = [0; new_cap]
            let mut idx = 0
            for elem in data step _ {
                new_data[idx] = elem
                idx = idx + 1
            }
            data = new_data
            cur_cap = new_cap
        } reconcile auto

        data[cur_len] = item
        let new_len = cur_len + 1

        struct {
            data = data,
            len = new_len,
            capacity = cur_cap
        }
    }

    routine Stack.pop(peek stack: Stack) -> Stack taking _ {
        let mut cur_len = stack.len
        let mut new_len = 0
        if (cur_len > 0) {
            new_len = cur_len - 1
        } reconcile auto
        struct {
            data = stack.data,
            len = new_len,
            capacity = stack.capacity
        }
    }

    routine Stack.peek(peek stack: Stack) -> i64 taking _ {
        let mut cur_len = stack.len
        let mut top_val = 0
        if (cur_len > 0) {
            let top_idx = cur_len - 1
            let data = stack.data
            top_val = data[top_idx]
        } reconcile auto
        top_val
    }

    routine Stack.is_empty(peek stack: Stack) -> bool taking _ {
        stack.len == 0
    }

    routine Stack.len(peek stack: Stack) -> i32 taking _ {
        stack.len
    }

    routine Stack.to_array(peek stack: Stack) -> array taking _ {
        let n = stack.len
        let data = stack.data
        data[0..n]
    }
}
