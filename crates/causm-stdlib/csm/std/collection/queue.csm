@0ms: {
    from "std/collection/types" import Queue
    from "std/core" import Option
}

@0ms: {
    routine Queue.new(peek capacity: i32) -> Queue taking _ {
        let cap = if (capacity > 0) { clone(capacity) } else { 16 }
        let raw = [0; cap]
        struct {
            capacity = cap,
            data = raw,
            head = 0,
            len = 0,
            tail = 0
        }
    }

    routine Queue.push(peek queue: Queue, peek item: i64) -> Queue taking _ {
        let mut cur_len = queue.len
        let mut cur_cap = queue.capacity
        let mut cur_head = queue.head
        let mut cur_tail = queue.tail
        let mut data = queue.data
        if (cur_len >= cur_cap) {
            let new_cap = cur_cap * 2
            let mut new_data = [0; new_cap]
            let mut i = 0
            while (i < cur_len) taking _ {
                let read_idx = (cur_head + i) % cur_cap
                new_data[i] = data[read_idx]
                i = i + 1
            }
            data = new_data
            cur_head = 0
            cur_tail = clone(cur_len)
            cur_cap = new_cap
        }
        data[cur_tail] = item
        let next_tail = (cur_tail + 1) % cur_cap
        let new_len = cur_len + 1
        struct {
            capacity = cur_cap,
            data = data,
            head = cur_head,
            len = new_len,
            tail = next_tail
        }
    }

    routine Queue.pop(peek queue: Queue) -> Queue taking _ {
        let cur_len = queue.len
        let cur_head = queue.head
        let next_head = if (cur_len > 0) {
            (cur_head + 1) % queue.capacity
        } else {
            clone(cur_head)
        }
        let new_len = if (cur_len > 0) { cur_len - 1 } else { 0 }
        struct {
            capacity = queue.capacity,
            data = queue.data,
            head = next_head,
            len = new_len,
            tail = queue.tail
        }
    }

    routine Queue.peek(peek queue: Queue) -> i64 taking _ => if (queue.len > 0) { queue.data[queue.head] } else { 0 }

    routine Queue.try_peek(peek queue: Queue) -> Option taking _ => if (queue.len > 0) {
        Option::Some(queue.data[queue.head])
    } else {
        Option::None
    }

    routine Queue.is_empty(peek queue: Queue) -> bool taking _ => queue.len == 0

    routine Queue.len(peek queue: Queue) -> i32 taking _ => queue.len

    routine Queue.to_array(peek queue: Queue) -> array taking _ {
        let mut cur_len = queue.len
        let mut cur_cap = queue.capacity
        let mut cur_head = queue.head
        let data = queue.data
        let mut out = [0; clone(cur_len)]
        let mut i = 0
        while (i < cur_len) taking _ {
            let read_idx = (cur_head + i) % cur_cap
            out[i] = data[read_idx]
            i = i + 1
        }
        out
    }
}
