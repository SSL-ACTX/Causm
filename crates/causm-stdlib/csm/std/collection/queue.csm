// Standard Collection Module - Queue (FIFO) Operations

from "std/collection/types" import Queue

@0ms: {
    routine Queue.new(peek capacity: i32) -> Queue taking _ {
        let mut cap = 16
        if (capacity > 0) {
            cap = clone(capacity)
        } reconcile auto
        let raw = [0; cap]
        struct {
            data = raw,
            head = 0,
            tail = 0,
            len = 0,
            capacity = cap
        }
    }

    routine Queue.push(peek queue: Queue, peek item: i64) -> Queue taking _ {
        let mut cur_len = queue.len
        let mut cur_cap = queue.capacity
        let mut cur_head = queue.head
        let mut cur_tail = queue.tail
        let mut data = queue.data

        if (cur_len >= cur_cap) {
            let new_cap = cur_cap * 2
            let mut new_data = [0; new_cap]
            let mut i = 0
            while (i < cur_len) taking _ {
                let read_idx = (cur_head + i) % cur_cap
                new_data[i] = data[read_idx]
                i = i + 1
            }
            data = new_data
            cur_head = 0
            cur_tail = clone(cur_len)
            cur_cap = new_cap
        } reconcile auto

        data[cur_tail] = item
        let next_tail = (cur_tail + 1) % cur_cap
        let new_len = cur_len + 1

        struct {
            data = data,
            head = cur_head,
            tail = next_tail,
            len = new_len,
            capacity = cur_cap
        }
    }

    routine Queue.pop(peek queue: Queue) -> Queue taking _ {
        let mut cur_len = queue.len
        let mut cur_head = queue.head
        let mut next_head = clone(cur_head)
        let mut new_len = 0
        if (cur_len > 0) {
            let cur_cap = queue.capacity
            next_head = (cur_head + 1) % cur_cap
            new_len = cur_len - 1
        } reconcile auto
        struct {
            data = queue.data,
            head = next_head,
            tail = queue.tail,
            len = new_len,
            capacity = queue.capacity
        }
    }

    routine Queue.peek(peek queue: Queue) -> i64 taking _ {
        let mut cur_len = queue.len
        let mut head_val = 0
        if (cur_len > 0) {
            let head_idx = queue.head
            let data = queue.data
            head_val = data[head_idx]
        } reconcile auto
        head_val
    }

    routine Queue.is_empty(peek queue: Queue) -> bool taking _ {
        queue.len == 0
    }

    routine Queue.len(peek queue: Queue) -> i32 taking _ {
        queue.len
    }

    routine Queue.to_array(peek queue: Queue) -> array taking _ {
        let mut cur_len = queue.len
        let mut cur_cap = queue.capacity
        let mut cur_head = queue.head
        let data = queue.data
        let mut out = [0; clone(cur_len)]
        let mut i = 0
        while (i < cur_len) taking _ {
            let read_idx = (cur_head + i) % cur_cap
            out[i] = data[read_idx]
            i = i + 1
        }
        out
    }
}
