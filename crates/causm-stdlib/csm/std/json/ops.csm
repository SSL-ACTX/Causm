@0ms: {
    from "std/json/types" import *

    routine Json.null_val() -> JsonValue taking _ => JsonValue::Null

    routine Json.bool_val(&b: bool) -> JsonValue taking _ => JsonValue::Bool(b)

    routine Json.num_val(&n: i64) -> JsonValue taking _ => JsonValue::Number(n)

    routine Json.str_val(&s: string) -> JsonValue taking _ => JsonValue::String(s)

    routine Json.arr_val(&items: array) -> JsonValue taking _ => JsonValue::Array(items)

    routine Json.obj_val(&members: array) -> JsonValue taking _ => JsonValue::Object(members)

    routine Json.member(&key: string, &val: JsonValue) -> JsonMember taking _ {
        let v = clone(val)
        struct { key = key, val = v }
    }

    routine Json.is_null(&v: JsonValue) -> bool taking _ => match v {
        JsonValue::Null => true,
        _ => false,
    }

    routine Json.is_bool(&v: JsonValue) -> bool taking _ => match v {
        JsonValue::Bool(_) => true,
        _ => false,
    }

    routine Json.is_number(&v: JsonValue) -> bool taking _ => match v {
        JsonValue::Number(_) => true,
        _ => false,
    }

    routine Json.is_string(&v: JsonValue) -> bool taking _ => match v {
        JsonValue::String(_) => true,
        _ => false,
    }

    routine Json.is_array(&v: JsonValue) -> bool taking _ => match v {
        JsonValue::Array(_) => true,
        _ => false,
    }

    routine Json.is_object(&v: JsonValue) -> bool taking _ => match v {
        JsonValue::Object(_) => true,
        _ => false,
    }

    routine Json.as_bool(&v: JsonValue) -> bool taking _ => match v {
        JsonValue::Bool(b) => b,
        _ => false,
    }

    routine Json.as_number(&v: JsonValue) -> i64 taking _ => match v {
        JsonValue::Number(n) => n,
        _ => 0,
    }

    routine Json.as_string(&v: JsonValue) -> string taking _ => match v {
        JsonValue::String(s) => s,
        _ => "",
    }

    routine Json.as_array(&v: JsonValue) -> array taking _ => match v {
        JsonValue::Array(arr) => arr,
        _ => [],
    }

    routine Json.as_object(&v: JsonValue) -> array taking _ => match v {
        JsonValue::Object(obj) => obj,
        _ => [],
    }

    routine Json.get(&obj: JsonValue, &key: string) -> JsonValue taking _ {
        let mut found = JsonValue::Null
        if let JsonValue::Object(members) = obj {
            for m in members step _ {
                if (m.key == key) {
                    let mv = m.val
                    found = clone(mv)
                    break
                }
            }
        }
        found
    }

    routine Json.has_key(&obj: JsonValue, &key: string) -> bool taking _ {
        let mut found = false
        if let JsonValue::Object(members) = obj {
            for m in members step _ {
                if (m.key == key) {
                    found = true
                    break
                }
            }
        }
        found
    }

    routine Json.get_int(&obj: JsonValue, &key: string, &default_val: i64) -> i64 taking _ {
        let v = Json.get(obj, key)
        match v {
            JsonValue::Number(n) => {
                n
            }
            _ => {
                default_val
            }
        }
    }

    routine Json.get_string(&obj: JsonValue, &key: string, &default_val: string) -> string taking _ {
        let v = Json.get(obj, key)
        match v {
            JsonValue::String(s) => {
                s
            }
            _ => {
                default_val
            }
        }
    }

    routine Json.get_bool(&obj: JsonValue, &key: string, &default_val: bool) -> bool taking _ {
        let v = Json.get(obj, key)
        match v {
            JsonValue::Bool(b) => {
                b
            }
            _ => {
                default_val
            }
        }
    }

    routine Json.array_len(&arr: JsonValue) -> i32 taking _ => match arr {
        JsonValue::Array(items) => len(items),
        _ => 0,
    }

    routine Json.array_get(&arr: JsonValue, &idx: i32) -> JsonValue taking _ {
        let mut res = JsonValue::Null
        if let JsonValue::Array(elements) = arr {
            let n = len(elements)
            if (idx >= 0 && idx < n) {
                let it = elements[idx]
                res = clone(it)
            }
        }
        res
    }

    routine Json.push_member(&members: array, &key: string, &val: JsonValue) -> array taking _ {
        let v = clone(val)
        let m = struct { key = key, val = v }
        push(members, m)
    }

    routine Json.push_value(&items: array, &val: JsonValue) -> array taking _ {
        let v = clone(val)
        push(items, v)
    }

    routine JsonValue.is_null(&self: JsonValue) -> bool taking _ => Json.is_null(self)

    routine JsonValue.is_bool(&self: JsonValue) -> bool taking _ => Json.is_bool(self)

    routine JsonValue.is_number(&self: JsonValue) -> bool taking _ => Json.is_number(self)

    routine JsonValue.is_string(&self: JsonValue) -> bool taking _ => Json.is_string(self)

    routine JsonValue.is_array(&self: JsonValue) -> bool taking _ => Json.is_array(self)

    routine JsonValue.is_object(&self: JsonValue) -> bool taking _ => Json.is_object(self)

    routine JsonValue.as_number(&self: JsonValue) -> i64 taking _ => Json.as_number(self)

    routine JsonValue.as_string(&self: JsonValue) -> string taking _ => Json.as_string(self)

    routine JsonValue.as_array(&self: JsonValue) -> array taking _ => Json.as_array(self)

    routine JsonValue.as_object(&self: JsonValue) -> array taking _ => Json.as_object(self)

    routine JsonValue.get(&self: JsonValue, &key: string) -> JsonValue taking _ => Json.get(self, key)

    routine JsonValue.has_key(&self: JsonValue, &key: string) -> bool taking _ => Json.has_key(self, key)

    routine JsonValue.get_int(&self: JsonValue, &key: string, &default_val: i64) -> i64 taking _ => Json.get_int(self, key, default_val)

    routine JsonValue.get_string(&self: JsonValue, &key: string, &default_val: string) -> string taking _ => Json.get_string(self, key, default_val)

    routine JsonValue.get_bool(&self: JsonValue, &key: string, &default_val: bool) -> bool taking _ => Json.get_bool(self, key, default_val)

    routine JsonValue.array_len(&self: JsonValue) -> i32 taking _ => Json.array_len(self)

    routine JsonValue.array_get(&self: JsonValue, &idx: i32) -> JsonValue taking _ => Json.array_get(self, idx)
}
