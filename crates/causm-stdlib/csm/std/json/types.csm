@0ms: {
    enum JsonValue {
        Null,
        Bool(bool),
        Number(i64),
        String(string),
        Array(array),
        Object(array)
    }

    type JsonMember = struct {
        key: string,
        val: JsonValue
    }

    type ParseResult = struct {
        next_pos: i32,
        val: JsonValue
    }

    type ParseStrResult = struct {
        next_pos: i32,
        val: string
    }
}
