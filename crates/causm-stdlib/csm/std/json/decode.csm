// Standard JSON Module - Decoder / Parser

@0ms: {
    from "std/json/types" import *

    routine Json.make_null() -> JsonValue taking _ =>
        struct {
            kind = 0,
            bool_val = false,
            num_val = 0,
            str_val = "",
            arr_val = [],
            obj_val = []
        }

    routine Json.make_bool(peek b: bool) -> JsonValue taking _ =>
        struct {
            kind = 1,
            bool_val = b,
            num_val = 0,
            str_val = "",
            arr_val = [],
            obj_val = []
        }

    routine Json.make_number(peek n: i64) -> JsonValue taking _ =>
        struct {
            kind = 2,
            bool_val = false,
            num_val = n,
            str_val = "",
            arr_val = [],
            obj_val = []
        }

    routine Json.make_string(peek s: string) -> JsonValue taking _ =>
        struct {
            kind = 3,
            bool_val = false,
            num_val = 0,
            str_val = s,
            arr_val = [],
            obj_val = []
        }

    routine Json.make_array(peek items: array) -> JsonValue taking _ =>
        struct {
            kind = 4,
            bool_val = false,
            num_val = 0,
            str_val = "",
            arr_val = items,
            obj_val = []
        }

    routine Json.make_object(peek members: array) -> JsonValue taking _ =>
        struct {
            kind = 5,
            bool_val = false,
            num_val = 0,
            str_val = "",
            arr_val = [],
            obj_val = members
        }

    routine Json.is_ws(peek b: i32) -> bool taking _ =>
        if (b == 32) {
            true
        } else if (b == 9) {
            true
        } else if (b == 10) {
            true
        } else if (b == 13) {
            true
        } else {
            false
        }

    routine Json.skip_ws(peek bytes: array, peek pos: i32, peek n: i32) -> i32 taking _ {
        let mut p = clone(pos)
        let mut limit = clone(n)
        while (p < limit) taking _ {
            let mut b = bytes[p]
            let ws = Json.is_ws(b)
            if (ws) {
                p = p + 1
            } else {
                break
            }
        }
        p
    }

    routine Json.parse_str_raw(peek bytes: array, peek pos: i32, peek n: i32) -> ParseStrResult taking _ {
        let mut p = pos + 1
        let mut limit = clone(n)
        let mut buf = [0; 256]
        let mut buf_cap = 256
        let mut out_len = 0

        while (p < limit) taking _ {
            let mut b = bytes[p]
            if (b == 34) {
                p = p + 1
                break
            } else if (b == 92) {
                p = p + 1
                if (p < limit) {
                    let mut esc = bytes[p]
                    let mut ch = esc
                    if (esc == 110) { ch = 10 }
                    else if (esc == 114) { ch = 13 }
                    else if (esc == 116) { ch = 9 }
                    else if (esc == 98) { ch = 8 }
                    else if (esc == 102) { ch = 12 }
                    else if (esc == 34) { ch = 34 }
                    else if (esc == 92) { ch = 92 }
                    else if (esc == 47) { ch = 47 }

                    if (out_len >= buf_cap) {
                        let new_cap = buf_cap * 2
                        let mut new_buf = [0; new_cap]
                        let mut ci = 0
                        for bi in buf step _ {
                            new_buf[ci] = bi
                            ci = ci + 1
                        }
                        buf = new_buf
                        buf_cap = new_cap
                    }
                    buf[out_len] = ch
                    out_len = out_len + 1
                    p = p + 1
                }
            } else {
                if (out_len >= buf_cap) {
                    let new_cap = buf_cap * 2
                    let mut new_buf = [0; new_cap]
                    let mut ci = 0
                    for bi in buf step _ {
                        new_buf[ci] = bi
                        ci = ci + 1
                    }
                    buf = new_buf
                    buf_cap = new_cap
                }
                buf[out_len] = b
                out_len = out_len + 1
                p = p + 1
            }
        }

        let slice = buf[0..out_len]
        let s = to_str(slice)
        struct {
            val = s,
            next_pos = p
        }
    }

    routine Json.parse_number(peek bytes: array, peek pos: i32, peek n: i32) -> ParseResult taking _ {
        let mut p = clone(pos)
        let mut limit = clone(n)
        let mut sign = 1
        if (p < limit) {
            let mut first_b = bytes[p]
            if (first_b == 45) {
                sign = -1
                p = p + 1
            }
        }
        let mut num = 0
        while (p < limit) taking _ {
            let mut b = bytes[p]
            if (b >= 48) {
                if (b <= 57) {
                    num = num * 10 + (b - 48)
                    p = p + 1
                } else {
                    break
                }
            } else {
                break
            }
        }
        let total = num * sign
        struct {
            val = Json.make_number(total),
            next_pos = p
        }
    }

    routine Json.parse_bool_or_null(peek bytes: array, peek pos: i32, peek n: i32) -> ParseResult taking _ {
        let mut b = bytes[pos]
        let mut res = struct {
            val = Json.make_null(),
            next_pos = pos + 4
        }
        if (b == 116) {
            res = struct {
                val = Json.make_bool(true),
                next_pos = pos + 4
            }
        } else if (b == 102) {
            res = struct {
                val = Json.make_bool(false),
                next_pos = pos + 5
            }
        }
        res
    }

    routine Json.parse_val(peek bytes: array, peek pos: i32, peek n: i32) -> ParseResult taking _ {
        let mut limit = clone(n)
        let p = Json.skip_ws(bytes, pos, limit)
        let mut result = struct { val = Json.make_null(), next_pos = limit }
        if (p < limit) {
            let mut b = bytes[p]
            if (b == 34) {
                let res = Json.parse_str_raw(bytes, p, limit)
                result = struct {
                    val = Json.make_string(res.val),
                    next_pos = res.next_pos
                }
            } else if (b == 123) {
                // object { ... }
                let mut cur = p + 1
                let mut members = []
                while (cur < limit) taking _ {
                    cur = Json.skip_ws(bytes, cur, limit)
                    if (cur >= limit) {
                        break
                    }
                    let mut check_b = bytes[cur]
                    if (check_b == 125) {
                        cur = cur + 1
                        break
                    }
                    if (check_b == 34) {
                        let k_res = Json.parse_str_raw(bytes, cur, limit)
                        let key_str = k_res.val
                        cur = Json.skip_ws(bytes, k_res.next_pos, limit)
                        if (cur < limit) {
                            let mut colon_b = bytes[cur]
                            if (colon_b == 58) {
                                cur = cur + 1
                            }
                        }
                        let v_res = Json.parse_val(bytes, cur, limit)
                        let mem_n = len(members)
                        let mut new_members = [struct { key = "", val = Json.make_null() }; mem_n + 1]
                        let mut mi = 0
                        for existing_m in members step _ {
                            let cloned_m = clone(existing_m)
                            new_members[mi] = cloned_m
                            mi = mi + 1
                        }
                        let v_val = v_res.val
                        let new_val = clone(v_val)
                        new_members[mem_n] = struct { key = key_str, val = new_val }
                        members = new_members
                        cur = Json.skip_ws(bytes, v_res.next_pos, limit)
                        if (cur < limit) {
                            let mut sep_b = bytes[cur]
                            if (sep_b == 44) {
                                cur = cur + 1
                            } else if (sep_b == 125) {
                                cur = cur + 1
                                break
                            }
                        }
                    } else {
                        cur = cur + 1
                    }
                }
                result = struct {
                    val = Json.make_object(members),
                    next_pos = cur
                }
            } else if (b == 91) {
                // array [ ... ]
                let mut cur = p + 1
                let mut items = []
                while (cur < limit) taking _ {
                    cur = Json.skip_ws(bytes, cur, limit)
                    if (cur >= limit) {
                        break
                    }
                    let mut arr_b = bytes[cur]
                    if (arr_b == 93) {
                        cur = cur + 1
                        break
                    }
                    let v_res = Json.parse_val(bytes, cur, limit)
                    let items_n = len(items)
                    let mut new_items = [Json.make_null(); items_n + 1]
                    let mut ii = 0
                    for existing_it in items step _ {
                        let cloned_it = clone(existing_it)
                        new_items[ii] = cloned_it
                        ii = ii + 1
                    }
                    let v_val = v_res.val
                    let push_v = clone(v_val)
                    new_items[items_n] = push_v
                    items = new_items
                    cur = Json.skip_ws(bytes, v_res.next_pos, limit)
                    if (cur < limit) {
                        let mut item_sep_b = bytes[cur]
                        if (item_sep_b == 44) {
                            cur = cur + 1
                        } else if (item_sep_b == 93) {
                            cur = cur + 1
                            break
                        }
                    }
                }
                result = struct {
                    val = Json.make_array(items),
                    next_pos = cur
                }
            } else if (b == 116) {
                result = Json.parse_bool_or_null(bytes, p, limit)
            } else if (b == 102) {
                result = Json.parse_bool_or_null(bytes, p, limit)
            } else if (b == 110) {
                result = Json.parse_bool_or_null(bytes, p, limit)
            } else if (b >= 48) {
                if (b <= 57) {
                    result = Json.parse_number(bytes, p, limit)
                } else {
                    result = struct { val = Json.make_null(), next_pos = p + 1 }
                }
            } else if (b == 45) {
                result = Json.parse_number(bytes, p, limit)
            } else {
                result = struct { val = Json.make_null(), next_pos = p + 1 }
            }
        }
        result
    }

    routine Json.decode(peek text: string) -> JsonValue taking _ {
        let bytes = str_bytes(text)
        let n = len(bytes)
        let res = Json.parse_val(bytes, 0, n)
        res.val
    }

    routine Json.parse(peek text: string) -> JsonValue taking _ => Json.decode(text)
}
