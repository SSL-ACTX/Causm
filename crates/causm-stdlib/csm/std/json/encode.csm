// Standard JSON Module - Encoder / Serializer

@0ms: {
    from "std/json/types" import *

    routine Json.escape_string(peek s: string) -> string taking _ {
        let bytes = str_bytes(s)
        let n = len(bytes)
        let mut buf = [0; n * 2 + 8]
        let mut out_len = 0

        buf[out_len] = 34
        out_len = out_len + 1

        for b in bytes step _ {
            let mut ch = b
            if (ch == 34) {
                buf[out_len] = 92
                buf[out_len + 1] = 34
                out_len = out_len + 2
            } else if (ch == 92) {
                buf[out_len] = 92
                buf[out_len + 1] = 92
                out_len = out_len + 2
            } else if (ch == 10) {
                buf[out_len] = 92
                buf[out_len + 1] = 110
                out_len = out_len + 2
            } else if (ch == 13) {
                buf[out_len] = 92
                buf[out_len + 1] = 114
                out_len = out_len + 2
            } else if (ch == 9) {
                buf[out_len] = 92
                buf[out_len + 1] = 116
                out_len = out_len + 2
            } else {
                buf[out_len] = ch
                out_len = out_len + 1
            }
        }

        buf[out_len] = 34
        out_len = out_len + 1

        let slice = buf[0..out_len]
        to_str(slice)
    }

    routine Json.stringify_array(peek items: array) -> string taking _ {
        let n = len(items)
        let mut res = "["
        let mut first = true
        for it in items step _ {
            if (!first) {
                res = res + ","
            }
            res = res + Json.stringify(it)
            first = false
        }
        res + "]"
    }

    routine Json.stringify_object(peek members: array) -> string taking _ {
        let mut res = "{"
        let mut first = true
        for m in members step _ {
            if (!first) {
                res = res + ","
            }
            let k_str = m.key
            let esc_k = Json.escape_string(k_str)
            let val_s = Json.stringify(m.val)
            res = res + esc_k + ":" + val_s
            first = false
        }
        res + "}"
    }

    routine Json.stringify(peek val: JsonValue) -> string taking _ =>
        if (val.kind == 0) {
            "null"
        } else if (val.kind == 1) {
            if (val.bool_val) { "true" } else { "false" }
        } else if (val.kind == 2) {
            f"{val.num_val}"
        } else if (val.kind == 3) {
            Json.escape_string(val.str_val)
        } else if (val.kind == 4) {
            Json.stringify_array(val.arr_val)
        } else if (val.kind == 5) {
            Json.stringify_object(val.obj_val)
        } else {
            "null"
        }

    routine Json.encode(peek val: JsonValue) -> string taking _ => Json.stringify(val)

    routine Json.from_int(peek n: i64) -> string taking _ => f"{n}"
    routine Json.from_bool(peek b: bool) -> string taking _ => if (b) { "true" } else { "false" }
    routine Json.from_string(peek s: string) -> string taking _ => Json.escape_string(s)
}
