@0ms: {
    from "std/json/types" import *

    routine Json.stringify(&val: JsonValue) -> string taking _ => json_stringify(val)

    routine Json.encode(&val: JsonValue) -> string taking _ => json_stringify(val)

    routine Json.from_int(&n: i64) -> string taking _ => f"{n}"

    routine Json.from_bool(&b: bool) -> string taking _ => if (b) { "true" } else { "false" }

    routine Json.from_string(&s: string) -> string taking _ => json_stringify(JsonValue::String(s))
}
