@0ms: {
    from "std/process/types" import *
    from "std/process/ffi" import *

    routine pid() -> i32 taking _ {
        if capability(System.FFI) {
            getpid()
        } else {
            1
        } reconcile auto
    }

    routine parent_pid() -> i32 taking _ {
        if capability(System.FFI) {
            getppid()
        } else {
            0
        } reconcile auto
    }

    routine info() -> ProcessInfo taking _ {
        if capability(System.FFI) {
            let { pid, ppid } = struct { pid = getpid(), ppid = getppid() }
            struct { is_running = true, pid = pid, ppid = ppid }
        } else {
            struct { is_running = true, pid = 1, ppid = 0 }
        } reconcile auto
    }

    routine send_signal(peek pid: i32, peek sig: i32) -> i32 taking _ {
        if capability(System.FFI) {
            kill(pid, sig)
        } else {
            -1
        } reconcile auto
    }

    routine kill_process(peek pid: i32) -> i32 taking _ => send_signal(pid, 9)

    routine terminate_process(peek pid: i32) -> i32 taking _ => send_signal(pid, 15)

    routine interrupt_process(peek pid: i32) -> i32 taking _ => send_signal(pid, 2)

    routine is_alive(peek pid: i32) -> bool taking _ {
        if capability(System.FFI) {
            kill(pid, 0) == 0
        } else {
            false
        } reconcile auto
    }

    routine create_pipe() -> ProcessPipe taking _ {
        if capability(System.FFI) {
            let mut fds = [0; 8]
            let rc = pipe(fds)
            let read_fd = fds[0] + fds[1] * 256
            let write_fd = fds[4] + fds[5] * 256
            struct { read_fd = read_fd, write_fd = write_fd }
        } else {
            struct { read_fd = -1, write_fd = -1 }
        } reconcile auto
    }

    routine run_command(peek cmd: string) -> ExitStatus taking _ {
        if capability(System.FFI) {
            let raw_status = system(cmd)
            let exit_code = (raw_status / 256) % 256
            let signaled = raw_status % 128 != 0
            let is_ok = exit_code == 0
            struct {
                code = exit_code,
                signaled = signaled,
                success = is_ok
            }
        } else {
            struct {
                code = 1,
                signaled = false,
                success = false
            }
        } reconcile auto
    }

    routine wait_for_pid(peek pid: i32, peek no_hang: bool) -> i32 taking _ {
        if capability(System.FFI) {
            let mut status = [0; 8]
            let options = if (no_hang) { 1 } else { 0 }
            waitpid(pid, status, options)
        } else {
            -1
        } reconcile auto
    }

    routine pipe_endpoints() -> PipeEndpoints taking _ {
        let p = create_pipe()
        struct {
            reader = struct { fd = p.read_fd },
            writer = struct { fd = p.write_fd }
        }
    }

    routine child_handle(peek pid: i32) -> ChildProcess taking _ => struct { is_running = true, pid = pid }

    routine pipe_write(peek fd: i32, peek buf: i64, peek len: i32) -> i64 taking _ {
        if capability(System.FFI) {
            write(fd, buf, len)
        } else {
            0
        } reconcile auto
    }

    routine pipe_read(peek fd: i32, peek buf: i64, peek len: i32) -> i64 taking _ {
        if capability(System.FFI) {
            read(fd, buf, len)
        } else {
            0
        } reconcile auto
    }

    routine close_fd(peek fd: i32) -> i32 taking _ {
        if capability(System.FFI) {
            close(fd)
        } else {
            0
        } reconcile auto
    }

    routine ExitStatus.is_success(peek self: ExitStatus) -> bool taking _ => self.success

    routine ExitStatus.exit_code(peek self: ExitStatus) -> i32 taking _ => self.code
}
