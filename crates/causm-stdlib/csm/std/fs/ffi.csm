// crates/causm-stdlib/csm/std/fs/ffi.csm - Comprehensive Low-Level POSIX File IO Foreign Bindings

foreign "libc.so.6" abi("C") {
    pub routine open(peek path: string, peek flags: i32, peek mode: i32) -> i32 taking 2ms
    pub routine creat(peek path: string, peek mode: i32) -> i32 taking 2ms
    pub routine read(peek fd: i32, peek buf: string, peek count: u64) -> i64 taking 3ms
    pub routine write(peek fd: i32, peek buf: string, peek count: u64) -> i64 taking 2ms
    pub routine close(consume fd: i32) -> i32 taking 1ms
    pub routine unlink(peek path: string) -> i32 taking 2ms
    pub routine rename(peek oldpath: string, peek newpath: string) -> i32 taking 2ms
    pub routine access(peek path: string, peek mode: i32) -> i32 taking 1ms
    pub routine lseek(peek fd: i32, peek offset: i64, peek whence: i32) -> i64 taking 1ms
    pub routine fsync(peek fd: i32) -> i32 taking 3ms
    pub routine ftruncate(peek fd: i32, peek length: i64) -> i32 taking 2ms
    pub routine mkdir(peek pathname: string, peek mode: i32) -> i32 taking 2ms
    pub routine rmdir(peek pathname: string) -> i32 taking 2ms
    pub routine fopen(peek path: string, peek mode: string) -> i64 taking 2ms
    pub routine fclose(peek stream: i64) -> i32 taking 1ms
}
