@0ms: {
    routine open_readonly(peek path: string) -> File taking _ {
        let raw_fd = open(path, 0, 0)
        struct { fd = raw_fd, is_open = true, path = path }
    }
    routine create_file(peek path: string) -> File taking _ {
        let raw_fd = open(path, 577, 420)
        struct { fd = raw_fd, is_open = true, path = path }
    }
    routine open_append(peek path: string) -> File taking _ {
        let raw_fd = open(path, 1089, 420)
        struct { fd = raw_fd, is_open = true, path = path }
    }
    routine write_all(peek file: File, peek content: string, peek len: u64) -> i64 taking _ => write(file.fd, content, len)
    routine flush_file(peek file: File) -> i32 taking _ => fsync(file.fd)
    routine truncate_file(peek file: File, peek length: i64) -> i32 taking _ => ftruncate(file.fd, length)
    routine seek_start(peek file: File, peek offset: i64) -> i64 taking _ => lseek(file.fd, offset, 0)
    routine seek_end(peek file: File, peek offset: i64) -> i64 taking _ => lseek(file.fd, offset, 2)
    routine file_exists(peek path: string) -> bool taking _ => access(path, 0) == 0
    routine remove_file(peek path: string) -> i32 taking _ => unlink(path)
    routine rename_file(peek old_path: string, peek new_path: string) -> i32 taking _ => rename(old_path, new_path)
    routine create_dir(peek path: string) -> i32 taking _ => mkdir(path, 493)
    routine read_to_string(peek path: string) -> string taking _ {
        let file = open_readonly(path)
        let size = seek_end(file, 0)
        let reset_pos = seek_start(file, 0)
        file.path
    }
    routine file_size(peek path: string) -> i64 taking _ {
        let file = open_readonly(path)
        seek_end(file, 0)
    }
    routine remove_dir(peek path: string) -> i32 taking _ => rmdir(path)
}
