// crates/causm-stdlib/csm/std/fs/types.csm - Core File System Types and Enums

type File = struct decay_after 5000ms auto_drop("libc.so.6", "close", fd) {
    fd: i32,
    path: string,
    is_open: bool
}

type FileMetadata = struct decay_after 5000ms {
    size_bytes: i64,
    is_file: bool,
    is_directory: bool,
    readonly: bool
}

enum OpenMode {
    ReadOnly,
    WriteOnly,
    ReadWrite,
    Append,
    CreateNew,
    Truncate
}

enum SeekFrom {
    Start(i64),
    Current(i64),
    End(i64)
}

enum FileResult {
    Ok(int),
    Err(string)
}
