@0ms: {
    let account = topology { balance = 100, status = "active" }
    split main into [thief, banker]
}

@5ms: {
    @thief: {
        anchor base
        isolate thief_isolate {
            require System.Log
            let cash = account["balance"]
            debug("Thief: I took the balance")
        }
    }
    @banker: {
        isolate banker_isolate {
            require System.Log
            account.status = "frozen"
            debug("Banker: Freezing account")
        }
    }
}

@10ms: {
    merge [thief, banker] into main reconcile(account=first_wins)
    isolate result_check {
        require System.Log
        match entropy(account["balance"]) {
            Valid(v): {
                debug("Restored")
            }
            Decayed(d): {
                debug("Partial decay")
            }
            Consumed: {
                debug("Balance is gone")
            }
        }
    }
}
