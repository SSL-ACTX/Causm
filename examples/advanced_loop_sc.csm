@0ms: {
    let counter: int = 0
    let total: int = 0

    while (counter < 5) (max 25ms) {
        total = total + counter
        counter = counter + 1
    }
    debug(counter)
    debug(total)

    let buffer = "sensor_stream_payload"
    let ticks = 0

    while valid (buffer) (max 30ms) {
        ticks = ticks + 1
        if (ticks == 3) {
            let extracted = buffer
            debug(extracted)
        } reconcile auto
    }
    debug(ticks)
}

@40ms: {
    let readings = [15, 42, 88, 23, 99]
    let sum = 0
    let peak = 0

    for val in readings step 10ms {
        sum = sum + val
        if (val > peak) {
            peak = val
        } reconcile auto
    }
    debug(sum)
    debug(peak)

    open_chan signal_bus(8)
    split main into [producer, consumer]
}

@50ms: {
    @producer: {
        let msg1 = "CRITICAL_ALERT"
        let msg2 = "SYSTEM_SYNC"
        let msg3 = "TERMINATE"

        chan_send signal_bus(msg1)
        chan_send signal_bus(msg2)
        chan_send signal_bus(msg3)
    }

    @consumer: {
        slice 20ms
        let count = 0
        let terminated = false

        loop tick on signal_bus {
            let msg = chan_recv(signal_bus)
            count = count + 1
            if (msg == "TERMINATE") {
                terminated = true
            } reconcile auto
            break
        }
        debug(count)
        debug(terminated)
    }
}

@70ms: {
    merge [producer, consumer] into main reconcile auto
}
