@0ms: {
    isolate fs_showcase {
        enable cpu(10000ms)
        enable memory(131072bytes)
        require System.FFI
        require System.Log
        from "std/fs" import *
        from "std/path" import *
        let base_dir = "/data/data/com.termux/files/home/Causm/target"
        let log_file_name = "causm_sys_audit.log"
        let target_path = join(clone(base_dir), clone(log_file_name))
        let extracted_base = path_basename(clone(target_path))
        print(extracted_base)
        let extracted_dir = path_dirname(clone(target_path))
        print(extracted_dir)
        let ext = extension(clone(target_path))
        print(ext)
        let file = create_file(clone(target_path))
        print(file.path)
        let payload = "CAUSM_STATUS=INITIALIZED,ENTROPY=0.0,CLOCK=0ms\n"
        let bytes_written = write_all(file, clone(payload), 46)
        print(bytes_written)
        let sync_code = flush_file(file)
        print(sync_code)
        let sz = file_size(clone(target_path))
        print(sz)
        let exists = file_exists(clone(target_path))
        print(exists)
        let read_back = read_to_string(clone(target_path))
        print(read_back)
        let archive_path = join(clone(base_dir), "causm_sys_audit_archive.log")
        let rename_status = rename_file(clone(target_path), clone(archive_path))
        let exists_orig = file_exists(clone(target_path))
        print(exists_orig)
        let exists_archive = file_exists(clone(archive_path))
        print(exists_archive)
        let rm_status = remove_file(clone(archive_path))
        print(rm_status)
        let exists_post_cleanup = file_exists(clone(archive_path))
        print(exists_post_cleanup)
    }
}
