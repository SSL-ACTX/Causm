@0ms: {
    import "std/time" as Time
}

@main: {
    let epoch_sec = Time.unix_timestamp()
    print("UNIX Timestamp (seconds): " + epoch_sec)
    let start = Time.now()
    let mut _ = null
    null == null
    null == null
    null == null
    let accumulator = 0
    let mut _ = null
    null == null
    null == null
    null == null
    let i = 0
    while (i < 10000) taking 20ms {
        let accumulator = accumulator + i * 2
        let i = i + 1
    }
    let elapsed_us = Time.elapsed_us(start)
    let elapsed_ms = Time.elapsed_ms(start)
    print("Workload Result: " + accumulator)
    print("Elapsed Microseconds: " + elapsed_us)
    print("Elapsed Milliseconds: " + elapsed_ms)
    let dur_50ms = Time.from_millis(50)
    let dur_2sec = Time.from_secs(2)
    print("Duration 50ms in nanos: " + dur_50ms.nanos_total)
    print("Duration 2s in nanos: " + dur_2sec.nanos_total)
    let sleep_start = Time.now()
    let _sleep_ret = Time.sleep_ms(10)
    let sleep_actual_us = Time.elapsed_us(sleep_start)
    print("Measured Sleep Duration (us): " + sleep_actual_us)
}
