@0ms: {
    import "std/net" as Net
    print("=== Causm std/net ===")
    print("Networking primitives: TCP, UDP, non-blocking, timeouts")
}

@10ms: {
    print("Phase 1: TCP Listener + Dot-Method Client")
    using listener = Net.TcpListener.bind(19870) {
        print("Listener bound on port: 19870")
        using client = Net.TcpStream.connect("127.0.0.1", 19870) {
            let server_conn = listener.accept()
            let payload = [65, 66, 67, 68, 69]
            let sent = client.send(payload, 5)
            print(f"Client sent {sent} bytes (ABCDE)")
            let buf = [0, 0, 0, 0, 0]
            let recvd = server_conn.recv(buf, 5)
            print(f"Server received {recvd} bytes")
            print(f"	Byte[0]={buf[0]}	Byte[4]={buf[4]}")
            let _cc = server_conn.close()
        }
        print("Phase 1 sockets closed.")
    }
}

@20ms: {
    print("Phase 2: Timeouts + send / recv")
    using listener2 = Net.TcpListener.bind(19871) {
        print("Listener 2 bound on port: 19871")
        using stream2 = Net.TcpStream.connect("127.0.0.1", 19871) {
            let client2 = listener2.accept()
            let sent2 = stream2.send([72, 101, 108, 108, 111], 5)
            print(f"Sent {sent2} bytes (Hello)")
            let buf2 = [0, 0, 0, 0, 0]
            let recvd2 = client2.recv(buf2, 5)
            print(f"Received {recvd2} bytes")
            print(f"	Byte[0]={buf2[0]}	Byte[4]={buf2[4]}")
            let _cc2 = client2.close()
        }
        print("Phase 2 sockets closed.")
    }
}

@30ms: {
    print("Phase 3: Non-Blocking Socket Control")
    using listener3 = Net.TcpListener.bind(19872) {
        using stream3 = Net.TcpStream.connect("127.0.0.1", 19872) {
            let client3 = listener3.accept()
            let nb_sent = stream3.send([78, 79, 78, 66, 76, 75], 6)
            print(f"Non-blocking send: {nb_sent} bytes (NONBLK)")
            let nb_buf = [0, 0, 0, 0, 0, 0]
            let nb_recvd = client3.recv(nb_buf, 6)
            print(f"Received in non-blocking mode: {nb_recvd} bytes")
            let _cc3 = client3.close()
        }
        print("Phase 3 sockets closed.")
    }
}

@40ms: {
    print("Phase 4: UDP Datagram Bidirectional Loopback")
    using udp_server = Net.udp_bind(19880) {
        print("UDP server bound on port: 19880")
        using udp_cli_listener = Net.udp_bind(19881) {
            let cli_fd = Net.create_udp_socket()
            let c2s = Net.udp_send_to(cli_fd, [80, 73, 78, 71], 4, 19880, 127, 0, 0, 1)
            print(f"UDP client sent {c2s} bytes (PING)")
            let ping_buf = [0, 0, 0, 0]
            let s_recvd = udp_server.recv_from(ping_buf, 4)
            print(f"UDP server received {s_recvd} bytes")
            print(f"	Byte[0]={ping_buf[0]}	Byte[3]={ping_buf[3]}")
            let s2c = udp_server.send_to([80, 79, 78, 71], 4, 19881, 127, 0, 0, 1)
            print(f"UDP server sent {s2c} bytes (PONG)")
            let pong_buf = [0, 0, 0, 0]
            let c_recvd = udp_cli_listener.recv_from(pong_buf, 4)
            print(f"UDP client received {c_recvd} bytes reply")
            print(f"	Byte[0]={pong_buf[0]}	Byte[3]={pong_buf[3]}")
            let _cu = Net.close_socket(cli_fd)
        }
        print("Phase 4 UDP sockets closed.")
    }
}

@50ms: {
    print("=== std/net showcase complete ===")
}
