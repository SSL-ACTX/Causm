@0ms: {
    let raw = struct { count = "0", b = "fieldB", a = "fieldA" }
    inspect raw_binding = raw {
        let raw_copy = clone(raw_binding)
        let a_check = raw_copy.a
        debug(a_check)
        debug(raw_binding.count)
    }
    print("starting split")
    split main into [w1, w2]
}

@w1: {
    anchor stage1
    let p = clone(raw)
    speculate (taking 40ms) {
        anchor speculation_start
        let first = p.a
        commit {
            let merged = struct { x = first, y = "inferred" }
            yield merged
        }
        collapse
    } fallback {
        let merged = struct { y = "", x = "failed" }
        yield merged
    }
}

@w2: {
    anchor stage2
    routine inspect_item(peek item) taking _ {
        let item_copy = clone(item)
        let _k = item.key
        let _v = item_copy.value
    }
    let q = raw
    for item consume q {
        let item_copy = clone(item)
        let key = item.key
        let value = item_copy.value
        commit {
            let result = struct { key = key, value = value }
        }
    }
}

@0ms: {
    merge [w1, w2] into main reconcile(raw=first_wins)
    open_chan ch1 (3)
    let hello = "hello"
    chan_send ch1 (hello)
    print("merged done")
    select (taking 10ms) {
        case m = chan_recv(ch1): {
            let out = m
        }
        timeout: {
            let out = "timeout"
        }
    } reconcile auto
}
