@0ms: {
    import "std/net" as Net
    import "std/collection" as Collection
    import "std/encoding/utf8" as Utf8
    import "std/encoding/binary" as Binary
    print("=== Causm std/net + std/collection Showcase ===")
    print("Zero-Manual-Close Networking with Dynamic Buffers, Packet Queues, Ring Buffers, and LIFO Stacks")
}

@10ms: {
    print("Phase 1: TCP HTTP Stream Chunking into Collection.Buffer")
    using listener = Net.TcpListener.bind(19870) {
        print("HTTP Server listening on port: 19870")
        using client = Net.TcpStream.connect("127.0.0.1", 19870) {
            let server_conn = listener.accept()
            let req_text = "GET /status HTTP/1.1\r\nHost: localhost\r\n\r\n"
            let req_bytes = Utf8.encode(req_text)
            let req_len = len(req_bytes)
            let sent = client.send(req_bytes, req_len)
            print(f"Client sent {sent} bytes HTTP request: {req_text}")
            let mut stream_buf = Collection.Buffer.new(32)
            let raw_chunk = [0; 48]
            let recvd = server_conn.recv(raw_chunk, req_len)
            let stream_buf = Collection.Buffer.append_slice(stream_buf, raw_chunk, recvd)
            let slice = Collection.Buffer.as_slice(stream_buf)
            let recvd_str = Utf8.decode(slice)
            print(f"Server received {recvd} bytes into Buffer (len: {stream_buf.len}): {recvd_str}")
            let res_text = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nCAUSM"
            let res_bytes = Utf8.encode(res_text)
            let res_len = len(res_bytes)
            let sent_res = server_conn.send(res_bytes, res_len)
            let res_buf = [0; 64]
            let recvd_res = client.recv(res_buf, res_len)
            let res_decoded = Utf8.decode(res_buf[0..recvd_res])
            print(f"Client received response: {res_decoded}")
        }
        print("Phase 1 HTTP session closed automatically.")
    }
}

@20ms: {
    print("Phase 2: Packet Scheduling with Collection.Queue (FIFO Dispatch)")
    using listener2 = Net.TcpListener.bind(19871) {
        using stream2 = Net.TcpStream.connect("127.0.0.1", 19871) {
            let client2 = listener2.accept()
            let mut pkt_queue = Collection.Queue.new(8)
            let pkt_queue = Collection.Queue.push(pkt_queue, 101)
            let pkt_queue = Collection.Queue.push(pkt_queue, 102)
            let pkt_queue = Collection.Queue.push(pkt_queue, 103)
            print(f"Enqueued 3 command packet IDs into Queue (len: {pkt_queue.len})")
            let p1 = Collection.Queue.peek(pkt_queue)
            let pkt_queue = Collection.Queue.pop(pkt_queue)
            let p2 = Collection.Queue.peek(pkt_queue)
            let pkt_queue = Collection.Queue.pop(pkt_queue)
            let p3 = Collection.Queue.peek(pkt_queue)
            let pkt_queue = Collection.Queue.pop(pkt_queue)
            let wire_packet = [p1, p2, p3]
            let sent2 = stream2.send(wire_packet, 3)
            print(f"Transmitted {sent2} queued packet bytes: [{p1}, {p2}, {p3}]")
            let buf2 = [0; 8]
            let recvd2 = client2.recv(buf2, 3)
            print(f"Server received {recvd2} packet bytes from stream: [{buf2[0]}, {buf2[1]}, {buf2[2]}]")
        }
        print("Phase 2 FIFO packet dispatch closed automatically.")
    }
}

@30ms: {
    print("Phase 3: Real-Time Sliding Window with Collection.RingBuffer")
    using listener3 = Net.TcpListener.bind(19872) {
        using stream3 = Net.TcpStream.connect("127.0.0.1", 19872) {
            let client3 = listener3.accept()
            let mut telemetry_ring = Collection.RingBuffer.new(4)
            let telemetry_ring = Collection.RingBuffer.push(telemetry_ring, 10)
            let telemetry_ring = Collection.RingBuffer.push(telemetry_ring, 20)
            let telemetry_ring = Collection.RingBuffer.push(telemetry_ring, 30)
            let telemetry_ring = Collection.RingBuffer.push(telemetry_ring, 40)
            let telemetry_ring = Collection.RingBuffer.push(telemetry_ring, 50)
            let ring_len = Collection.RingBuffer.len(telemetry_ring)
            print(f"RingBuffer active telemetry items: {ring_len}")
            let latest_sample = Collection.RingBuffer.peek(telemetry_ring)
            let telemetry_ring = Collection.RingBuffer.pop(telemetry_ring)
            let sample_bytes = [latest_sample]
            let nb_sent = stream3.send(sample_bytes, 1)
            print(f"Streamed latest ring sample {latest_sample} ({nb_sent} byte)")
            let nb_buf = [0; 8]
            let nb_recvd = client3.recv(nb_buf, 1)
            print(f"Receiver got sliding window telemetry: {nb_buf[0]}")
        }
        print("Phase 3 ring buffer streaming closed automatically.")
    }
}

@40ms: {
    print("Phase 4: UDP Datagram History with Collection.Stack (LIFO Audit)")
    using udp_server = Net.udp_bind(19880) {
        print("UDP Heartbeat server bound on port: 19880")
        using udp_cli_listener = Net.udp_bind(19881) {
            using cli_sock = Net.udp_socket() {
                let mut audit_stack = Collection.Stack.new(8)
                let ping_msg = "HEARTBEAT_PING"
                let ping_bytes = Utf8.encode(ping_msg)
                let ping_len = len(ping_bytes)
                let c2s = cli_sock.send_to_ip(ping_bytes, ping_len, "127.0.0.1", 19880)
                print(f"UDP Client sent {c2s} bytes: {ping_msg}")
                let ping_buf = [0; 16]
                let s_recvd = udp_server.recv_from(ping_buf, ping_len)
                let s_ping_str = Utf8.decode(ping_buf[0..s_recvd])
                print(f"UDP Server received {s_recvd} bytes: {s_ping_str}")
                let audit_stack = Collection.Stack.push(audit_stack, s_recvd)
                let pong_msg = if (s_ping_str == "HEARTBEAT_PING") {
                    "HEARTBEAT_PONG"
                } else {
                    "HEARTBEAT_ERR"
                }
                let pong_bytes = Utf8.encode(pong_msg)
                let pong_len = len(pong_bytes)
                let s2c = udp_server.send_to_ip(pong_bytes, pong_len, "127.0.0.1", 19881)
                print(f"UDP Server replied {s2c} bytes: {pong_msg}")
                let pong_buf = [0; 16]
                let c_recvd = udp_cli_listener.recv_from(pong_buf, pong_len)
                let c_pong_str = Utf8.decode(pong_buf[0..c_recvd])
                print(f"UDP Client received reply: {c_pong_str}")
                let audit_stack = Collection.Stack.push(audit_stack, c_recvd)
                let last_recvd = Collection.Stack.peek(audit_stack)
                let audit_stack = Collection.Stack.pop(audit_stack)
                let rem_len = Collection.Stack.len(audit_stack)
                print(f"LIFO Audit Stack popped most recent UDP transfer: {last_recvd} bytes (remaining: {rem_len})")
            }
        }
        print("Phase 4 UDP heartbeat complete and auto-closed.")
    }
}

@50ms: {
    print("Phase 5: Binary Header Packing + Wire Frames")
    let port_bytes = Binary.write_u16_be(8080)
    let plen = len(port_bytes)
    print(f"Binary-packed port 8080 (BE): {plen} bytes")
    debug(port_bytes)
    let addr_bytes = Binary.write_u32_be(2130706433)
    let alen = len(addr_bytes)
    print(f"Binary-packed IP 127.0.0.1 (BE): {alen} bytes")
    debug(addr_bytes)
}

@60ms: {
    print("=== All Net Showcase Phases Completed Successfully ===")
}
