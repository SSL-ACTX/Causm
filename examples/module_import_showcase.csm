@0ms: {
    isolate main_system {
        enable cpu(5000ms)
        enable memory(64KB)
        require System.Log

        import "sensor_math.csm" as Math
        from "sensor_types.csm" import SensorMode

        let raw_reading = 100
        let scaling_factor = 4
        let ref_raw = &raw_reading
        print("Raw Reading Reference:")
        print(ref_raw)

        let digest = call Math.compute_digest(raw_reading, scaling_factor)
        print("Computed Telemetry Digest:")
        print(digest)

        let calibrated = call Math.calibrate_reading(digest)
        print("Calibrated Signal Value:")
        print(calibrated)

        let telemetry_pack = struct { status = "operational", score = calibrated }
        lease current_pack = telemetry_pack 40ms {
            let score_val = current_pack.score
            print("Leased Telemetry Score:")
            print(score_val)
        } reconcile auto

        let entropic_status = match entropy(raw_reading) {
            Valid(v) if v == 100: {
                let s = "verified_high_precision"
                s
            }
            Valid(v): {
                let s = "standard_valid"
                s
            }
            Consumed: {
                let s = "consumed_stream"
                s
            }
        }
        print("Entropic Verification Status:")
        print(entropic_status)
    }
}
