@main: {
    type SensorPacket = struct {
        baseline: int,
        raw_voltage: int,
        gain: int
    }
    routine filter_signal(peek packet: SensorPacket) -> int taking 19ms {
        let normalized = packet.raw_voltage - packet.baseline
        let amplified = normalized * packet.gain
        let filtered = amplified / 2
        yield filtered
    }
    let sample: SensorPacket = struct { gain = 4, baseline = 128, raw_voltage = 1024 }
    let result = call filter_signal(sample)
    print(result)
}
