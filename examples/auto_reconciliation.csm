@0ms: {
    let status = "pending"
    let sensor_active = true
    if (sensor_active) {
        let status = "online"
    } else {
        let status = "offline"
    } reconcile auto
    print("Sensor Status: " + status)
    let packet = struct { checksum = "0x11", header = "REQ_104", payload = "0xFA99" }
    let is_secure = false
    if (is_secure) {
        let data = packet.payload
        print("Secure branch extracted payload: " + data)
    } else {
        let h = packet.header
        let c = packet.checksum
        print("Insecure branch extracted header/checksum")
    } reconcile auto
    match entropy(packet) {
        Valid(v): {
            print("ERROR: Packet should not be fully valid here.")
        }
        Decayed(d): {
            print("Packet successfully decayed after branch reconciliation.")
        }
        Consumed: {
            print("ERROR: Packet should not be fully consumed here.")
        }
    }
}
