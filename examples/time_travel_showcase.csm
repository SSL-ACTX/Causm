@0ms: {
    print("--- Causm Time Travel & Reversing Showcase ---")
    let bank_balance = 1000
    print("Initial bank balance: " + bank_balance)
    speculate (taking 20ms) {
        let bank_balance = bank_balance + 500
        let market_crash = true
        if (market_crash) {
            print("MARKET CRASH! Collapsing speculation...")
            collapse
        }
        commit {
            print("Investment successful.")
            yield bank_balance
        }
    } fallback {
        print("Fallback: Speculation failed. Local state reverted.")
        print("Reverted balance: " + bank_balance)
    }
    let cloud_config = topology { instances = 10, region = "us-east-1" }
    print("Splitting for concurrent infrastructure updates...")
    split main into [dev_branch, ops_branch]
}

@10ms: {
    @dev_branch: {
        anchor stable_config
        cloud_config.instances = 20
        print("Dev: Scaling up to 20 instances.")
    }
    @ops_branch: {
        cloud_config.region = "eu-central-1"
        print("Ops: Migrating region to eu-central-1.")
    }
}

@20ms: {
    print("Merging updates with safety constraints...")
    merge [dev_branch, ops_branch] into main reconcile(cloud_config=first_wins)
    print("Merge complete. Final config:")
    print("Region: " + cloud_config["region"])
    print("Instances: " + cloud_config["instances"])
}

@30ms: {
    print("Demonstrating Speculation and Collapse Safety...")
    let counter = 10
    speculate (taking 10ms) {
        let counter = 20
        collapse
    } fallback {
        print("Speculation safely collapsed, state reverted")
    }
    print("Causality preserved.")
}
