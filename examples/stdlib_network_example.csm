@0ms: {
  isolate primary_gateway {
    enable cpu(100ms)
    enable memory(10KB)
    require System.NetworkFetch
    require System.Log

    let endpoint = "https://httpbin.org/get"
    let req = defer System.NetworkFetch(url: endpoint, latency: 5ms) deadline 100ms
    let status

    debug("Initiating HTTP NetworkFetch pipeline...")
  }
}

@10ms: {
  isolate handler {
    require System.Log

    await(req)

    status = match entropy(req) {
      Valid(val): "Gateway Connected [HTTP 200]"
      Pending(p): "Gateway Response Pending"
      Consumed:   "Gateway Timed Out / Breached Deadline"
    }

    print("Network Request Status:")
    print(status)
  }
}
