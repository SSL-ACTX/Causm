@0ms: {
    let a = 10
    let b = 3
    
    // Modulo
    let mod = clone(a) % clone(b)
    print("10 % 3 =")
    debug(mod)
    
    // Power
    let p1 = 2 ^ 3
    print("2 ^ 3 =")
    debug(p1)
    
    let p2 = 2.0 ^ 0.5
    print("2.0 ^ 0.5 =")
    debug(p2)
    
    // Unary Negation
    let neg_a = -clone(a)
    print("-10 =")
    debug(neg_a)
    
    let neg_f = -2.5
    print("-2.5 =")
    debug(neg_f)
    
    // Logical NOT
    let t = true
    let f = !t
    print("!true =")
    debug(f)
    
    // Complex expression
    let complex = -(clone(a) + clone(b)) * (2 ^ 2) % 7
    print("-(10 + 3) * (2 ^ 2) % 7 =")
    debug(complex)
    
    // Power with negative exponent
    let neg_pow = 2 ^ -1
    print("2 ^ -1 =")
    debug(neg_pow)
}
