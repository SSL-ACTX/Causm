// ============================================================================
// ICTL Formal Showcase: Temporal Promises and Entropic State Branching
// ============================================================================
// This example demonstrates the formal semantics of asynchronous promises,
// temporal deadlines, and entropic state matching within isolated timelines.
// ============================================================================

@0ms: {
  // ------------------------------------------------------------------------
  // Phase 1: Initialization and Deferred Execution
  // ------------------------------------------------------------------------
  // We initialize two deferred network operations (promises) with specific
  // simulated latencies and strict temporal deadlines.
  // The local clock does NOT advance during 'defer' initialization.
  
  isolate gateway_init {
    enable cpu(100ms)
    enable memory(5KB)
    require System.NetworkFetch
    require System.Log

    // Primary data source: expected latency 30ms, deadline 40ms.
    let primary_req = defer System.NetworkFetch(url="api.primary.internal", latency="30") deadline 40ms
    
    // Backup data source: expected latency 60ms, strict deadline 50ms (will fail).
    let backup_req = defer System.NetworkFetch(url="api.backup.internal", latency="60") deadline 50ms

    // At this coordinate (@0ms), both 'primary_req' and 'backup_req' are in
    // the 'Pending' entropic state.
    debug("Initialization complete. Promises are Pending.")
  }

  // Define a formal routine to process valid data, which consumes exactly 10ms.
  routine process_payload(peek payload) taking 10ms {
    let processed = "Processed: " + payload
    yield processed
  }
}

@10ms: {
  // ------------------------------------------------------------------------
  // Phase 2: Timeline Bifurcation
  // ------------------------------------------------------------------------
  // We split the main timeline into two concurrent workers to handle the
  // promises independently. Each worker inherits a snapshot of the memory arena.
  split main into [primary_worker, backup_worker]
}

@primary_worker: {
  // ------------------------------------------------------------------------
  // Phase 3A: Primary Worker Execution
  // ------------------------------------------------------------------------
  isolate primary_handler {
    require System.Log

    // Advance the local clock of this branch to the promise's ready_at timestamp.
    await(primary_req)

    // Entropic State Branching: Safely handle the resolution state.
    match entropy(primary_req) {
      Valid(val): {
        // The promise resolved within the deadline. 'val' is extracted.
        let result = call process_payload(val)
        let w1_status = "Primary Success: " + result
      }
      Pending(p): {
        // Unreachable here due to prior 'await', but semantically required.
        let w1_status = "Primary Pending"
      }
      Consumed: {
        // Occurs if the deadline was exceeded.
        let w1_status = "Primary Timeout"
      }
    }
  }
}

@backup_worker: {
  // ------------------------------------------------------------------------
  // Phase 3B: Backup Worker Execution
  // ------------------------------------------------------------------------
  isolate backup_handler {
    require System.Log

    // The backup promise has a latency of 60ms but a deadline of 50ms.
    // 'await' will advance the clock, but the deadline will be breached.
    await(backup_req)

    match entropy(backup_req) {
      Valid(val): {
        let result = call process_payload(val)
        let w2_status = "Backup Success: " + result
      }
      Pending(p): {
        let w2_status = "Backup Pending"
      }
      Consumed: {
        // The promise transitions to 'Consumed' because local_clock > deadline.
        let w2_status = "Backup Failed: Deadline Exceeded"
      }
    }
  }
}

@80ms: {
  // ------------------------------------------------------------------------
  // Phase 4: Timeline Reconciliation
  // ------------------------------------------------------------------------
  // Merge the concurrent branches back into the main timeline.
  // We explicitly resolve the outputs from the isolated workers.
  merge [primary_worker, backup_worker] into main resolving(primary_final = w1_status, backup_final = w2_status)

  isolate telemetry {
    require System.Log
    
    let summary = "Gateway Telemetry Report:"
    print(summary)
    
    // Output the resolved states from both branches.
    require System.Log(message = primary_final)
    require System.Log(message = backup_final)
  }
}
