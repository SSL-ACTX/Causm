@0ms: {
    routine compute_ema(&current: int, &prev: int) -> int taking 20ms {
        let weight = 2
        let p1 = current * weight
        let p2 = prev * 8
        let sum = p1 + p2
        let ema = sum / 10
        yield ema
    }

    isolate dsp_pipeline {
        enable memory(102400bytes)
        slice 40ms
        require System.Log
        let mut s1 = 150
        let mut s2 = 155
        let mut signal = 0
        loop tick {
            signal = compute_ema(s2, s1)
            break
        }
        loop tick {
            let display = "Signal: " + signal
            print(display)
            break
        }
    }
}
