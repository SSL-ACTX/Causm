@main: {
    speculate (max 50ms) {
        // Ephemeral entropy introduced during speculative execution
        let ephemeral_secret = 777
        let processed = ephemeral_secret * 2
        // Note: No commit statement was executed here!
    }

    // ILLEGAL: Attempting to access ephemeral_secret outside the speculative epoch
