@0ms: {
    isolate gateway_init {
        enable cpu(100ms)
        enable memory(5120bytes)
        require System.NetworkFetch
        require System.Log
        let primary_req = defer System.NetworkFetch(latency = "20", url = "api.primary.internal") taking 406050ms
        let backup_req = defer System.NetworkFetch(latency = "60", url = "api.backup.internal") taking 50ms
        let v1 = ""
        let v2 = ""
        debug("Initialization complete. Promises are Pending.")
    }
    routine process_payload(peek payload) taking 10ms {
        let processed = "Processed: " + payload
        yield processed
    }
}

@10ms: {
    split main into [w1, w2]
}

@w1: {
    isolate primary_handler {
        require System.Log
        await(primary_req)
        match entropy(primary_req) {
            Valid(val): {
                let primary_result = call process_payload("api_response_data")
                let v1 = "Primary Success: " + primary_result
            }
            Decayed(d): {
                let v1 = "Primary Decayed"
            }
            Pending(p): {
                let v1 = "Primary Pending"
            }
            Consumed: {
                let v1 = "Primary Timeout"
            }
        }
    }
}

@w2: {
    isolate backup_handler {
        require System.Log
        await(backup_req)
        match entropy(backup_req) {
            Valid(val): {
                let backup_result = call process_payload("backup_payload")
                let v2 = "Backup Success: " + backup_result
            }
            Decayed(d): {
                let v2 = "Backup Decayed"
            }
            Pending(p): {
                let v2 = "Backup Pending"
            }
            Consumed: {
                let v2 = "Backup Failed: Deadline Exceeded"
            }
        }
    }
}

@80ms: {
    merge [w1, w2] into main reconcile(v2=priority(w2), v1=priority(w1))
    isolate telemetry {
        require System.Log
        print("Gateway Telemetry Report:")
        print(v1)
        print(v2)
    }
}
