@0ms: {
  isolate gateway_init {
    enable cpu(100ms)
    enable memory(5KB)
    require System.NetworkFetch
    require System.Log

    let primary_req = defer System.NetworkFetch(url="api.primary.internal", latency="30") deadline 40ms
    // backup latency 60ms > deadline 50ms, so it will breach
    let backup_req = defer System.NetworkFetch(url="api.backup.internal", latency="60") deadline 50ms

    debug("Initialization complete. Promises are Pending.")
  }

  routine process_payload(peek payload) taking 10ms {
    let processed = "Processed: " + payload
    yield processed
  }
}

@10ms: {
  split main into [primary_worker, backup_worker]
}

@primary_worker: {
  isolate primary_handler {
    require System.Log
    await(primary_req)

    match entropy(primary_req) {
      Valid(val): {
        let primary_result = call process_payload(val)
        let w1_status = "Primary Success: " + primary_result
      }
      Pending(p): {
        let w1_status = "Primary Pending"
      }
      Consumed: {
        let w1_status = "Primary Timeout"
      }
      Decayed(d): {
        let w1_status = "Primary Decayed"
      }
    }
  }
}

@backup_worker: {
  isolate backup_handler {
    require System.Log
    await(backup_req)

    match entropy(backup_req) {
      Valid(val): {
        let backup_result = call process_payload(val)
        let w2_status = "Backup Success: " + backup_result
      }
      Pending(p): {
        let w2_status = "Backup Pending"
      }
      Consumed: {
        // local_clock > deadline → transitions to Consumed
        let w2_status = "Backup Failed: Deadline Exceeded"
      }
      Decayed(d): {
        let w2_status = "Backup Decayed"
      }
    }
  }
}

@80ms: {
  merge [primary_worker, backup_worker] into main

  isolate telemetry {
    require System.Log
    print("Gateway Telemetry Report:")
    let primary_final = w1_status
    let backup_final = w2_status
    require System.Log(message = primary_final)
    require System.Log(message = backup_final)
  }
}
